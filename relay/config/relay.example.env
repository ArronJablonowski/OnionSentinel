# Copy to /etc/so-alert-relay/relay.env on the Pi.
# Do not commit the real file.

RELAY_WEBHOOK_URL=http://10.77.7.225:5678/webhook/security-onion-alert
RELAY_WEBHOOK_TOKEN=replace-with-long-random-token

# Optional but recommended for relay failure/recovery notifications.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
RELAY_HOST_LABEL="Raspberry Pi SOC relay 10.88.8.8"
# Notify after this many consecutive failed relay polls. This avoids noisy
# failure/recovery pairs when one Security Onion SSH pull times out.
RELAY_FAILURE_NOTIFY_THRESHOLD=3

# The broker checkpoints bounded Security Onion streams and uses size-aware
# rsync limits. Allow the outer worker to survive a healthy large transfer;
# per-stage timeouts and 30-second progress heartbeats still detect stalls.
RELAY_PCAP_TIMEOUT_SECONDS=43200

# Five-minute root and external SSD health thresholds. The storage monitor uses an exact,
# read-only smartctl sudo rule installed by install-pi-relay.sh.
RELAY_ROOT_MOUNT=/
RELAY_ROOT_MIN_FREE_BYTES=2147483648
RELAY_ROOT_WARN_USED_PERCENT=75
RELAY_ROOT_HARD_USED_PERCENT=80
RELAY_SSD_MOUNT=/mnt/onion-sentinel-pcap-spool
RELAY_SSD_DEVICE=/dev/sda
RELAY_SSD_MIN_FREE_BYTES=214748364800
RELAY_SSD_MAX_USED_PERCENT=75
RELAY_SSD_MAX_TEMPERATURE_C=70
RELAY_SSD_MAX_UNSAFE_SHUTDOWNS=0
