[Unit]
Description=Security Onion alert poll and durable alert delivery
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=soalert
Group=soalert
WorkingDirectory=/opt/so-alert-relay/app
EnvironmentFile=/etc/so-alert-relay/relay.env
ExecStart=/usr/bin/python3 /opt/so-alert-relay/app/relay_health_wrapper.py --component alert
TimeoutStartSec=5min
