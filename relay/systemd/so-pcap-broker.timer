[Unit]
Description=Process Onion Sentinel PCAP requests independently

[Timer]
OnBootSec=3min
# Schedule from service completion, not activation. A long transfer therefore
# receives a recovery interval instead of immediately starting the next read.
# The worker remains single-flight, bandwidth-capped, and capture-loss gated.
OnUnitInactiveSec=1min
AccuracySec=15s
Persistent=true
Unit=so-pcap-broker.service

[Install]
WantedBy=timers.target
