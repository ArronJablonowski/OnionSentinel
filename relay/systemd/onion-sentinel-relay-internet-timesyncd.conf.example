[Time]
# Temporary mode for relay VLANs where the local firewall/NTP service is not
# ready yet. Prefer the VLAN-local template once that service is working.
# Copy this file to:
#   /etc/systemd/timesyncd.conf.d/onion-sentinel-relay-vlan.conf
NTP=0.debian.pool.ntp.org 1.debian.pool.ntp.org 2.debian.pool.ntp.org 3.debian.pool.ntp.org
FallbackNTP=time.cloudflare.com time.google.com
PollIntervalMinSec=32
PollIntervalMaxSec=300
