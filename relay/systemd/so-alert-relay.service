[Unit]
Description=Security Onion alert relay poll
# Wait for the Pi network stack before trying SSH/webhook/Telegram.
Wants=network-online.target
After=network-online.target

[Service]
# The relay runs once and exits. The timer starts it every five minutes.
Type=oneshot
User=soalert
Group=soalert
WorkingDirectory=/opt/so-alert-relay/app
# Contains webhook/Telegram secrets; keep mode 0640 root:soalert.
EnvironmentFile=/etc/so-alert-relay/relay.env
ExecStart=/usr/bin/python3 /opt/so-alert-relay/app/relay_health_wrapper.py
