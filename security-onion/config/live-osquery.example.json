{
  "enabled": false,
  "kibana_url": "http://127.0.0.1:5601",
  "space": "default",
  "authorization_profile": "kibana-feature-osquery-all-brokered-v1",
  "authorization_file": "/etc/onion-sentinel/live-osquery.authorization",
  "ca_file": "",
  "verify_tls": false,
  "allow_loopback_http": true,
  "target_aliases": {
    "REPLACE_WITH_OPERATOR_ENDPOINT_ALIAS": "REPLACE_WITH_EXACT_FLEET_AGENT_ID"
  },
  "query_timeout_seconds": 60,
  "batch_timeout_seconds": 120,
  "max_concurrent_queries": 4,
  "result_visibility_seconds": 60,
  "poll_seconds": 2
}
