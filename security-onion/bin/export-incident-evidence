#!/usr/bin/env python3
"""Read a bounded, fixed evidence pack from Security Onion Elasticsearch.

This forced-command wrapper is intentionally not a general query proxy.  It
accepts only exact observables and named evidence packs, builds Elasticsearch
Query DSL locally, uses fixed per-pack indices, validates shard/hit metadata,
and records an equivalent KQL filter for analyst audit. Security Onion remains
read-only and neither the caller nor an LLM can choose indices, fields, DSL,
shell arguments, or result sizes.
"""
from __future__ import annotations

import datetime as dt
import fnmatch
import hashlib
import json
import glob
import re
import subprocess
import sys
import time
from pathlib import Path


MAX_REQUEST_BYTES = 16 * 1024
MAX_OUTPUT_BYTES = 8 * 1024 * 1024
MAX_HITS = 200
MAX_WINDOWS = 4
QUERY_TIMEOUT_SECONDS = 45
OSQUERY_TIMEOUT_SECONDS = 20
MAX_OSQUERY_OUTPUT_BYTES = 2 * 1024 * 1024
MAX_OSQUERY_ROWS = 200
SO_QUERY = Path("/usr/sbin/so-elasticsearch-query")
QUERY_CONTRACT = "onion-sentinel-incident-evidence-v2"
QUERY_PREFERENCE = "onion-sentinel-incident-evidence"
ALERT_INDEX_SCOPE = [
    "logs-suricata.alerts-so",
    "logs-detections.alerts-so",
]
PACKS = {
    "alert_context": {
        "indices": ALERT_INDEX_SCOPE,
        "datasets": ["suricata.alert"],
        "fields": ["@timestamp", "event.*", "rule.*", "source.*", "destination.*", "network.*", "message"],
    },
    "network_flow": {
        "indices": [
            "logs-zeek.connection-*",
            "logs-endpoint.events.network-*",
            *ALERT_INDEX_SCOPE,
        ],
        "datasets": ["zeek.connection", "endpoint.events.network", "suricata.alert"],
        "fields": ["@timestamp", "event.*", "source.*", "destination.*", "network.*", "host.*", "process.*", "message"],
    },
    "dns_activity": {
        "indices": [
            "logs-zeek.dns-*",
            "logs-endpoint.events.network-*",
        ],
        "datasets": ["zeek.dns", "endpoint.events.network"],
        "fields": ["@timestamp", "event.*", "dns.*", "url.*", "source.*", "destination.*", "host.*", "process.*", "message"],
    },
    "osquery_history": {
        "indices": [
            "logs-endpoint.events.process-*",
            "logs-endpoint.events.file-*",
            "logs-endpoint.events.network-*",
            "logs-osquery_manager.result-*",
            "logs-osquery_manager.response-*",
        ],
        "datasets": ["endpoint.events.process", "endpoint.events.file", "endpoint.events.network", "osquery_manager.result", "osquery_manager.response"],
        "fields": ["@timestamp", "event.*", "host.*", "user.*", "process.*", "file.*", "source.*", "destination.*", "message"],
    },
    "cross_sensor_timeline": {
        "indices": [
            *ALERT_INDEX_SCOPE,
            "logs-zeek.connection-*",
            "logs-zeek.dns-*",
            "logs-endpoint.events.network-*",
            "logs-endpoint.events.process-*",
            "logs-endpoint.events.file-*",
        ],
        "datasets": ["suricata.alert", "zeek.connection", "zeek.dns", "endpoint.events.network", "endpoint.events.process", "endpoint.events.file"],
        "fields": ["@timestamp", "event.*", "rule.*", "source.*", "destination.*", "network.*", "dns.*", "url.*", "host.*", "user.*", "process.*", "file.*", "message"],
    },
}
OSQUERY_PACKS = {
    "system_inventory": (
        "SELECT hostname, uuid, cpu_brand, cpu_physical_cores, "
        "cpu_logical_cores, physical_memory, hardware_vendor, hardware_model "
        "FROM system_info LIMIT 1;"
    ),
    "logged_in_users": (
        "SELECT user, tty, host, time, type, pid FROM logged_in_users "
        "ORDER BY time DESC LIMIT 100;"
    ),
    "listening_ports": (
        "SELECT lp.protocol, lp.address, lp.port, lp.pid, p.name, p.path "
        "FROM listening_ports AS lp LEFT JOIN processes AS p ON lp.pid = p.pid "
        "ORDER BY lp.port LIMIT 200;"
    ),
    "process_inventory": (
        "SELECT pid, parent, name, path, uid, gid, start_time FROM processes "
        "ORDER BY pid LIMIT 200;"
    ),
    "installed_packages": (
        "SELECT name, version, release, source, arch FROM rpm_packages "
        "ORDER BY name LIMIT 200;"
    ),
    "scheduled_tasks": (
        "SELECT event, minute, hour, day_of_month, month, day_of_week, command, path "
        "FROM crontab ORDER BY path LIMIT 200;"
    ),
    "startup_items": (
        "SELECT name, path, args, type, status, source FROM startup_items "
        "ORDER BY name LIMIT 200;"
    ),
}
OBSERVABLE_FIELDS = {
    "ips": ["source.ip", "destination.ip", "client.ip", "server.ip", "host.ip"],
    "domains": ["dns.question.name", "url.domain", "server.domain", "destination.domain"],
    "hosts": ["host.id", "host.name", "agent.id"],
    "users": ["user.id", "user.name"],
}
SAFE_VALUE = re.compile(r"^[A-Za-z0-9_.:@-]{1,255}$")
SAFE_ELASTIC_ID = re.compile(r"^[A-Za-z0-9_.:@+=-]{1,512}$")


def fail(message: str, code: int = 2) -> None:
    print(json.dumps({"ok": False, "error": message}, separators=(",", ":")))
    raise SystemExit(code)


def parse_time(value: object) -> dt.datetime:
    text = str(value or "").strip().replace("  ", "T")
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    parsed = dt.datetime.fromisoformat(text)
    if parsed.tzinfo is None:
        raise ValueError("timestamp must include a UTC offset")
    return parsed.astimezone(dt.timezone.utc)


def iso_utc(value: dt.datetime) -> str:
    return value.astimezone(dt.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def read_request() -> dict:
    raw = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1)
    if len(raw) > MAX_REQUEST_BYTES:
        fail("request exceeds the 16384-byte limit")
    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        fail(f"invalid JSON request: {exc}")
    if not isinstance(data, dict):
        fail("request root must be an object")
    return data


def index_matches_scope(index_name: str, index_scope: list[str]) -> bool:
    """Return whether an Elasticsearch backing index belongs to a reviewed scope."""
    return any(
        fnmatch.fnmatchcase(index_name, pattern)
        or fnmatch.fnmatchcase(index_name, f".ds-{pattern}-*")
        for pattern in index_scope
    )


def validated_anchor(value: object) -> dict[str, str] | None:
    """Validate the collector-owned representative alert identifier.

    Missing anchors remain protocol-compatible with older collectors, but the
    response can never be semantically valid or complete without one.
    """
    if value is None:
        return None
    if not isinstance(value, dict):
        fail("anchor must be an object")
    index_name = str(value.get("index") or "").strip()
    document_id = str(value.get("id") or "").strip()
    if (
        not index_name
        or "*" in index_name
        or "?" in index_name
        or not index_matches_scope(index_name, ALERT_INDEX_SCOPE)
    ):
        fail("anchor index is not an allowlisted Security Onion alert index")
    if not SAFE_ELASTIC_ID.fullmatch(document_id):
        fail("anchor id is invalid")
    return {"index": index_name, "id": document_id}


def validated_request(
    data: dict,
) -> tuple[list[str], list[str], list[dict], dict[str, list[str]], int, dict[str, str] | None]:
    packs = data.get("packs") or list(PACKS)
    if not isinstance(packs, list) or not packs or len(packs) > len(PACKS):
        fail("packs must be a non-empty bounded list")
    packs = [str(item) for item in packs]
    if len(set(packs)) != len(packs) or any(item not in PACKS for item in packs):
        fail("one or more evidence packs are not allowlisted")
    osquery_packs = data.get("osquery_packs") or list(OSQUERY_PACKS)
    if (
        not isinstance(osquery_packs, list)
        or not osquery_packs
        or len(osquery_packs) > len(OSQUERY_PACKS)
    ):
        fail("osquery_packs must be a non-empty bounded list")
    osquery_packs = [str(item) for item in osquery_packs]
    if (
        len(set(osquery_packs)) != len(osquery_packs)
        or any(item not in OSQUERY_PACKS for item in osquery_packs)
    ):
        fail("one or more OSquery packs are not allowlisted")
    windows = data.get("windows")
    if not isinstance(windows, list) or not windows or len(windows) > MAX_WINDOWS:
        fail(f"windows must contain 1-{MAX_WINDOWS} entries")
    clean_windows = []
    for item in windows:
        if not isinstance(item, dict):
            fail("each window must be an object")
        try:
            start, end = parse_time(item.get("start")), parse_time(item.get("end"))
        except (TypeError, ValueError) as exc:
            fail(f"invalid evidence window: {exc}")
        if end <= start or end - start > dt.timedelta(hours=24):
            fail("each evidence window must be positive and no longer than 24 hours")
        clean_windows.append({"start": iso_utc(start), "end": iso_utc(end)})
    observables = data.get("observables") or {}
    if not isinstance(observables, dict):
        fail("observables must be an object")
    clean_observables: dict[str, list[str]] = {}
    for kind in OBSERVABLE_FIELDS:
        values = observables.get(kind) or []
        if not isinstance(values, list) or len(values) > 16:
            fail(f"{kind} must contain at most 16 values")
        clean = []
        for value in values:
            text = str(value or "").strip()
            if not SAFE_VALUE.fullmatch(text):
                fail(f"invalid {kind} observable")
            if text not in clean:
                clean.append(text)
        clean_observables[kind] = clean
    if not any(clean_observables.values()):
        fail("at least one exact observable is required")
    size = data.get("size", 100)
    try:
        size = int(size)
    except (TypeError, ValueError):
        fail("size must be an integer")
    if size < 1 or size > MAX_HITS:
        fail(f"size must be between 1 and {MAX_HITS}")
    anchor = validated_anchor(data.get("anchor"))
    return packs, osquery_packs, clean_windows, clean_observables, size, anchor


def observable_clause(observables: dict[str, list[str]]) -> dict:
    should = []
    for kind, fields in OBSERVABLE_FIELDS.items():
        for value in observables.get(kind, []):
            should.extend({"term": {field: value}} for field in fields)
    return {"bool": {"should": should, "minimum_should_match": 1}}


def dataset_clause(datasets: list[str]) -> dict:
    should = []
    for dataset in datasets:
        should.append({"term": {"event.dataset": dataset}})
        should.append({"prefix": {"event.dataset": dataset + "."}})
    return {"bool": {"should": should, "minimum_should_match": 1}}


def kql_equivalent(window: dict, datasets: list[str], observables: dict[str, list[str]]) -> str:
    dataset = " or ".join(f'event.dataset : "{value}"' for value in datasets)
    obs = []
    for kind, fields in OBSERVABLE_FIELDS.items():
        for value in observables.get(kind, []):
            obs.append("(" + " or ".join(f'{field} : "{value}"' for field in fields) + ")")
    return f'@timestamp >= "{window["start"]}" and @timestamp <= "{window["end"]}" and ({dataset}) and (' + " or ".join(obs) + ")"


def query_endpoint(index_scope: list[str]) -> str:
    indices = ",".join(index_scope)
    return (
        f"{indices}/_search"
        f"?ignore_unavailable=true&expand_wildcards=open&preference={QUERY_PREFERENCE}"
    )


def canonical_digest(value: object) -> str:
    encoded = json.dumps(value, separators=(",", ":"), sort_keys=True)
    return hashlib.sha256(encoded.encode()).hexdigest()


def search_audit(body: dict, index_scope: list[str]) -> dict:
    endpoint = query_endpoint(index_scope)
    return {
        "query_digest": canonical_digest(body),
        "execution_digest": canonical_digest({
            "index_scope": index_scope,
            "query_endpoint": endpoint,
            "query_dsl": body,
        }),
        "query_dsl": body,
        "index_scope": list(index_scope),
        "query_endpoint": endpoint,
    }


def bounded_error(value: object) -> str:
    if isinstance(value, str):
        return value[:1000]
    try:
        return json.dumps(value, separators=(",", ":"), sort_keys=True)[:1000]
    except (TypeError, ValueError):
        return str(value)[:1000]


def empty_search_result(body: dict, index_scope: list[str], status: str, duration_ms: int, **extra) -> dict:
    return {
        **search_audit(body, index_scope),
        "status": status,
        "semantic_valid": False,
        "total_hits": 0,
        "total_hits_relation": "eq",
        "returned_hits": 0,
        "truncated": False,
        "duration_ms": duration_ms,
        "timed_out": status == "timeout",
        "took_ms": 0,
        "shards": {
            "total": 0,
            "successful": 0,
            "skipped": 0,
            "failed": 0,
            "failures": [],
        },
        "hits": [],
        **extra,
    }


def parse_shards(value: object) -> dict:
    if not isinstance(value, dict):
        raise ValueError("Elasticsearch response is missing _shards metadata")
    parsed = {}
    for field in ("total", "successful", "failed"):
        item = value.get(field)
        if isinstance(item, bool) or not isinstance(item, int) or item < 0:
            raise ValueError(f"Elasticsearch _shards.{field} is invalid")
        parsed[field] = item
    skipped = value.get("skipped", 0)
    if isinstance(skipped, bool) or not isinstance(skipped, int) or skipped < 0:
        raise ValueError("Elasticsearch _shards.skipped is invalid")
    if parsed["failed"] > parsed["total"] or parsed["successful"] > parsed["total"]:
        raise ValueError("Elasticsearch shard counts are inconsistent")
    failures = value.get("failures") or []
    if not isinstance(failures, list):
        raise ValueError("Elasticsearch _shards.failures is invalid")
    parsed["skipped"] = skipped
    parsed["failures"] = [
        {
            "index": str(item.get("index") or "")[:255],
            "type": str(((item.get("reason") or {}).get("type") if isinstance(item.get("reason"), dict) else "") or "")[:255],
            "reason": str(((item.get("reason") or {}).get("reason") if isinstance(item.get("reason"), dict) else item.get("reason")) or "")[:1000],
        }
        for item in failures[:20]
        if isinstance(item, dict)
    ]
    return parsed


def execute_search(body: dict, index_scope: list[str]) -> dict:
    audit = search_audit(body, index_scope)
    encoded = json.dumps(body, separators=(",", ":"), sort_keys=True)
    started = time.monotonic()
    try:
        proc = subprocess.run(
            [str(SO_QUERY), audit["query_endpoint"], "-d", encoded],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=QUERY_TIMEOUT_SECONDS,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return empty_search_result(
            body,
            index_scope,
            "timeout",
            QUERY_TIMEOUT_SECONDS * 1000,
            error="Elasticsearch query exceeded the wrapper timeout",
        )
    duration_ms = round((time.monotonic() - started) * 1000)
    if len(proc.stdout) > MAX_OUTPUT_BYTES:
        return empty_search_result(
            body,
            index_scope,
            "output_limit",
            duration_ms,
            error="Elasticsearch response exceeded the wrapper output limit",
        )
    if proc.returncode != 0:
        error = proc.stderr.decode("utf-8", "replace")[:1000]
        return empty_search_result(body, index_scope, "error", duration_ms, error=error)
    try:
        parsed = json.loads(proc.stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        return empty_search_result(body, index_scope, "invalid_response", duration_ms, error=str(exc))
    if not isinstance(parsed, dict):
        return empty_search_result(
            body,
            index_scope,
            "invalid_response",
            duration_ms,
            error="Elasticsearch response root must be an object",
        )
    if parsed.get("error") is not None:
        return empty_search_result(
            body,
            index_scope,
            "error",
            duration_ms,
            error=bounded_error(parsed.get("error")),
        )
    try:
        shards = parse_shards(parsed.get("_shards"))
    except ValueError as exc:
        return empty_search_result(body, index_scope, "invalid_response", duration_ms, error=str(exc))
    timed_out = parsed.get("timed_out")
    if not isinstance(timed_out, bool):
        return empty_search_result(
            body,
            index_scope,
            "invalid_response",
            duration_ms,
            shards=shards,
            error="Elasticsearch timed_out flag is missing or invalid",
        )
    took_ms = parsed.get("took")
    if isinstance(took_ms, bool) or not isinstance(took_ms, int) or took_ms < 0:
        return empty_search_result(
            body,
            index_scope,
            "invalid_response",
            duration_ms,
            timed_out=timed_out,
            shards=shards,
            error="Elasticsearch took value is missing or invalid",
        )
    if timed_out:
        return empty_search_result(
            body,
            index_scope,
            "timeout",
            duration_ms,
            timed_out=True,
            took_ms=took_ms,
            shards=shards,
            error="Elasticsearch reported a timed-out partial response",
        )
    if shards["failed"]:
        return empty_search_result(
            body,
            index_scope,
            "error",
            duration_ms,
            took_ms=took_ms,
            shards=shards,
            error=f"Elasticsearch returned {shards['failed']} failed shard(s)",
        )
    if shards["total"] == 0 or shards["successful"] == 0:
        return empty_search_result(
            body,
            index_scope,
            "invalid_response",
            duration_ms,
            took_ms=took_ms,
            shards=shards,
            error="Elasticsearch query matched no searchable shards in its reviewed index scope",
        )
    hits_root = parsed.get("hits")
    if not isinstance(hits_root, dict) or not isinstance(hits_root.get("hits"), list):
        return empty_search_result(
            body,
            index_scope,
            "invalid_response",
            duration_ms,
            took_ms=took_ms,
            shards=shards,
            error="Elasticsearch hits.hits must be an array",
        )
    raw_hits = hits_root["hits"]
    requested_size = body.get("size")
    if (
        isinstance(requested_size, bool)
        or not isinstance(requested_size, int)
        or requested_size < 0
        or len(raw_hits) > requested_size
    ):
        return empty_search_result(
            body,
            index_scope,
            "invalid_response",
            duration_ms,
            took_ms=took_ms,
            shards=shards,
            error="Elasticsearch returned more hits than the reviewed request size",
        )
    hits = []
    for hit in raw_hits:
        if not isinstance(hit, dict):
            return empty_search_result(
                body,
                index_scope,
                "invalid_response",
                duration_ms,
                took_ms=took_ms,
                shards=shards,
                error="Elasticsearch hit entries must be objects",
            )
        document_id = str(hit.get("_id") or "")
        index_name = str(hit.get("_index") or "")
        source = hit.get("_source")
        if (
            not document_id
            or not index_name
            or not isinstance(source, dict)
            or not index_matches_scope(index_name, index_scope)
        ):
            return empty_search_result(
                body,
                index_scope,
                "invalid_response",
                duration_ms,
                took_ms=took_ms,
                shards=shards,
                error=f"Elasticsearch returned an invalid or out-of-scope hit index: {index_name[:255]}",
            )
        hits.append({"id": document_id, "index": index_name, "source": source})
    total = hits_root.get("total")
    relation = "eq"
    if isinstance(total, dict):
        relation = total.get("relation")
        total = total.get("value")
    if (
        isinstance(total, bool)
        or not isinstance(total, int)
        or total < len(hits)
        or relation not in {"eq", "gte"}
    ):
        return empty_search_result(
            body,
            index_scope,
            "invalid_response",
            duration_ms,
            took_ms=took_ms,
            shards=shards,
            error="Elasticsearch hits.total metadata is invalid",
        )
    return {
        **audit,
        "status": "ok",
        "semantic_valid": True,
        "total_hits": total,
        "total_hits_relation": relation,
        "returned_hits": len(hits),
        "truncated": relation != "eq" or total > len(hits),
        "duration_ms": duration_ms,
        "timed_out": False,
        "took_ms": took_ms,
        "shards": shards,
        "hits": hits,
    }


def execute_pack(pack_name: str, window: dict, observables: dict[str, list[str]], size: int) -> dict:
    pack = PACKS[pack_name]
    body = {
        "size": size,
        "track_total_hits": True,
        "timeout": "30s",
        "sort": [{"@timestamp": {"order": "asc", "unmapped_type": "date"}}, "_shard_doc"],
        "_source": pack["fields"],
        "query": {"bool": {"filter": [
            {"range": {"@timestamp": {"gte": window["start"], "lte": window["end"]}}},
            dataset_clause(pack["datasets"]),
            observable_clause(observables),
        ]}},
    }
    return {"pack": pack_name, **execute_search(body, pack["indices"])}


def execute_controls(anchor: dict[str, str] | None) -> dict:
    if anchor is None:
        missing = {
            "status": "not_requested",
            "passed": False,
            "semantic_valid": False,
            "error": "A representative Security Onion alert anchor was not supplied",
        }
        return {
            "anchor": None,
            "positive_anchor": dict(missing),
            "negative_filter": dict(missing),
        }

    positive_body = {
        "size": 1,
        "track_total_hits": True,
        "timeout": "30s",
        "_source": ["@timestamp", "event.dataset"],
        "query": {"ids": {"values": [anchor["id"]]}},
    }
    positive = execute_search(positive_body, ALERT_INDEX_SCOPE)
    exact_hits = [
        item for item in positive.get("hits", [])
        if item.get("id") == anchor["id"] and item.get("index") == anchor["index"]
    ]
    positive["passed"] = (
        positive.get("status") == "ok"
        and positive.get("total_hits_relation") == "eq"
        and positive.get("total_hits") == 1
        and len(exact_hits) == 1
    )
    if positive.get("status") == "ok" and not positive["passed"]:
        positive["error"] = "The exact representative alert anchor was not returned exactly once"

    # An intentionally contradictory query proves that the endpoint applied
    # the supplied filters rather than replaying or substituting the positive
    # control response.
    negative_body = {
        "size": 1,
        "track_total_hits": True,
        "timeout": "30s",
        "_source": ["@timestamp", "event.dataset"],
        "query": {
            "bool": {
                "filter": [{"ids": {"values": [anchor["id"]]}}],
                "must_not": [{"ids": {"values": [anchor["id"]]}}],
            },
        },
    }
    negative = execute_search(negative_body, ALERT_INDEX_SCOPE)
    negative["passed"] = (
        negative.get("status") == "ok"
        and negative.get("total_hits_relation") == "eq"
        and negative.get("total_hits") == 0
        and negative.get("returned_hits") == 0
    )
    if negative.get("status") == "ok" and not negative["passed"]:
        negative["error"] = "The contradictory negative control unexpectedly returned hits"
    return {
        "anchor": anchor,
        "positive_anchor": positive,
        "negative_filter": negative,
    }


def semantic_validity(results: list[dict], osquery_results: list[dict], controls: dict) -> dict:
    query_execution_valid = all(
        result.get("status") == "ok" and result.get("semantic_valid") is True
        for result in results
    )
    osquery_valid = all(result.get("status") == "ok" for result in osquery_results)
    controls_valid = all(
        (controls.get(name) or {}).get("passed") is True
        for name in ("positive_anchor", "negative_filter")
    )
    coverage_valid = query_execution_valid and osquery_valid
    semantic_valid = controls_valid and coverage_valid
    reasons = []
    if not controls_valid:
        reasons.append("representative alert controls did not both pass")
    if not query_execution_valid:
        reasons.append("one or more Elasticsearch packs failed semantic validation")
    if not osquery_valid:
        reasons.append("one or more fixed local OSquery packs failed")
    return {
        "transport_valid": True,
        "controls_valid": controls_valid,
        "query_execution_valid": query_execution_valid,
        "coverage_valid": coverage_valid,
        "semantic_valid": semantic_valid,
        "reasons": reasons,
    }


def osquery_binary() -> Path | None:
    """Return the managed Elastic Agent osqueryd without accepting a caller path."""
    candidates = sorted(
        glob.glob("/opt/Elastic/Agent/data/elastic-agent-*/components/osqueryd"),
        reverse=True,
    )
    for candidate in candidates:
        path = Path(candidate)
        if path.is_file():
            return path
    return None


def execute_osquery_pack(binary: Path, pack_name: str) -> dict:
    """Run one reviewed query as ephemeral osqueryi and preserve its exact audit."""
    query = OSQUERY_PACKS[pack_name]
    digest = hashlib.sha256(query.encode("utf-8")).hexdigest()
    started = time.monotonic()
    base = {
        "pack": pack_name,
        "target": "security-onion-local-host",
        "query": query,
        "query_digest": digest,
    }
    try:
        proc = subprocess.run(
            ["osqueryi", "--disable_database", "--json", query],
            executable=str(binary),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=OSQUERY_TIMEOUT_SECONDS,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return {
            **base,
            "status": "timeout",
            "total_rows": 0,
            "returned_rows": 0,
            "truncated": False,
            "duration_ms": OSQUERY_TIMEOUT_SECONDS * 1000,
            "rows": [],
        }
    duration_ms = round((time.monotonic() - started) * 1000)
    if len(proc.stdout) > MAX_OSQUERY_OUTPUT_BYTES:
        return {
            **base,
            "status": "output_limit",
            "total_rows": 0,
            "returned_rows": 0,
            "truncated": False,
            "duration_ms": duration_ms,
            "rows": [],
        }
    if proc.returncode != 0:
        return {
            **base,
            "status": "error",
            "total_rows": 0,
            "returned_rows": 0,
            "truncated": False,
            "duration_ms": duration_ms,
            "rows": [],
            "error": proc.stderr.decode("utf-8", "replace")[:1000],
        }
    try:
        parsed = json.loads(proc.stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        return {
            **base,
            "status": "invalid_response",
            "total_rows": 0,
            "returned_rows": 0,
            "truncated": False,
            "duration_ms": duration_ms,
            "rows": [],
            "error": str(exc),
        }
    if not isinstance(parsed, list) or any(not isinstance(row, dict) for row in parsed):
        return {
            **base,
            "status": "invalid_response",
            "total_rows": 0,
            "returned_rows": 0,
            "truncated": False,
            "duration_ms": duration_ms,
            "rows": [],
            "error": "osquery result root must be an array of objects",
        }
    rows = parsed[:MAX_OSQUERY_ROWS]
    return {
        **base,
        "status": "ok",
        "total_rows": len(parsed),
        "returned_rows": len(rows),
        "truncated": len(parsed) > len(rows),
        "duration_ms": duration_ms,
        "rows": rows,
    }


def main() -> int:
    if not SO_QUERY.is_file():
        fail("Security Onion query CLI is unavailable", 3)
    binary = osquery_binary()
    if binary is None:
        fail("managed Elastic Agent osqueryd is unavailable", 3)
    packs, osquery_packs, windows, observables, size, anchor = validated_request(read_request())
    results = []
    for window_index, window in enumerate(windows):
        for pack_name in packs:
            result = execute_pack(pack_name, window, observables, size)
            result.update({
                "window_index": window_index,
                "window": window,
                "kql_equivalent": kql_equivalent(window, PACKS[pack_name]["datasets"], observables),
            })
            results.append(result)
    osquery_results = [
        execute_osquery_pack(binary, pack_name)
        for pack_name in osquery_packs
    ]
    controls = execute_controls(anchor)
    validity = semantic_validity(results, osquery_results, controls)
    complete = validity["semantic_valid"]
    response = {
        # A failed evidence pack is an explicit investigative gap, not a
        # transport failure. Returning a successful protocol response lets the
        # incident worker preserve all other pack results and report the gap.
        "ok": True,
        "complete": complete,
        "partial": not complete,
        "read_only": True,
        "query_contract": QUERY_CONTRACT,
        "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
        "observables": observables,
        "results": results,
        "osquery_results": osquery_results,
        "controls": controls,
        "semantic_validity": validity,
    }
    output = json.dumps(response, separators=(",", ":"), sort_keys=True).encode()
    if len(output) > MAX_OUTPUT_BYTES:
        fail("bounded evidence response exceeded the output contract", 4)
    sys.stdout.buffer.write(output + b"\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
