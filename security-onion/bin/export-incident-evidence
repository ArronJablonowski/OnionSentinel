class BoundedCommandError(RuntimeError):
    """Raised after a child is terminated for timeout or output overflow."""

    def __init__(self, reason: str, message: str):
        super().__init__(message)
        self.reason = reason



_evidence_owner_dir = Path(__file__).resolve().parent
if str(_evidence_owner_dir) not in sys.path:
    sys.path.insert(0, str(_evidence_owner_dir))
import so_evidence_transport
