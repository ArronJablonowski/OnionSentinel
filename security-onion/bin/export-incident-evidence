class _EvidenceRuntime:
    """Late-bound ports preserve the forced-command API and injected test seams.

    Owners never import this entry point. The adapter retains configuration and
    audit ownership, and supplies the original bounded operations to each owner.
    """
    def __init__(self, namespace):
        self._namespace = namespace

    def __getattr__(self, name):
        return self._namespace[name]


_evidence_runtime = _EvidenceRuntime(globals())

def run_bounded_command(
    command: list[str],
    *,
    timeout_seconds: float,
    max_stdout_bytes: int,
    max_stderr_bytes: int,
) -> subprocess.CompletedProcess:
    """Delegate through the stable evidence runtime boundary."""
    return so_evidence_transport.run_bounded_command(_evidence_runtime, command, timeout_seconds=timeout_seconds, max_stdout_bytes=max_stdout_bytes, max_stderr_bytes=max_stderr_bytes)


