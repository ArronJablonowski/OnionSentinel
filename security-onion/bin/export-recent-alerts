#!/bin/bash
set -euo pipefail

# Security Onion forced-command wrapper. The Pi connects as so-ai-relay, but SSH
# authorized_keys forces this script regardless of the command the client sends.
LOOKBACK="${SO_ALERT_LOOKBACK:-10m}"
SIZE="${SO_ALERT_SIZE:-500}"
MAX_SIZE=500
MAX_TOTAL="${SO_ALERT_MAX_TOTAL:-5000}"
QUERY_BIN="${SO_ELASTICSEARCH_QUERY_BIN:-/usr/sbin/so-elasticsearch-query}"

# Clamp caller-controlled size to prevent accidental heavy Elasticsearch pulls.
if ! [[ "$SIZE" =~ ^[0-9]+$ ]]; then
  SIZE=500
fi
if (( SIZE > MAX_SIZE )); then
  SIZE=$MAX_SIZE
fi
if ! [[ "$MAX_TOTAL" =~ ^[0-9]+$ ]] || (( MAX_TOTAL < SIZE )); then
  MAX_TOTAL=$SIZE
fi
if (( MAX_TOTAL > 20000 )); then
  MAX_TOTAL=20000
fi

QUERY_FILE=$(mktemp)
RAW_FILE=$(mktemp)
HITS_FILE=$(mktemp)
NEXT_HITS_FILE=$(mktemp)
trap 'rm -f "$QUERY_FILE" "$RAW_FILE" "$HITS_FILE" "$NEXT_HITS_FILE"' EXIT
printf '[]\n' > "$HITS_FILE"
POLL_END="$(date -u '+%Y-%m-%dT%H:%M:%S.%3NZ')"
SEARCH_AFTER=""
FETCHED=0
PAGES=0
TOTAL=0

# Pull the full Security Onion alert document. The Pi forwards this JSON as-is;
# Mac Studio stores it in SQLite and renders it in each alert detail page. This
# full-fidelity mode may include packet, payload, PCAP, and HTTP body fields when
# Security Onion has them available.
while (( FETCHED < MAX_TOTAL )); do
  if [[ -n "$SEARCH_AFTER" ]]; then
    SEARCH_AFTER_FIELD=",\n  \"search_after\": $SEARCH_AFTER"
  else
    SEARCH_AFTER_FIELD=""
  fi
  printf '{
  "size": %s,
  "sort": [{"@timestamp": {"order": "desc"}}, "_shard_doc"],
  "track_total_hits": true,
  "_source": true,
  "query": {"range": {"@timestamp": {"gte": "now-%s", "lte": "%s"}}}%b
}\n' "$SIZE" "$LOOKBACK" "$POLL_END" "$SEARCH_AFTER_FIELD" > "$QUERY_FILE"

  "$QUERY_BIN" \
    'logs-suricata.alerts-so,logs-detections.alerts-so/_search?ignore_unavailable=true&preference=onion-sentinel-alert-export' \
    -d @"$QUERY_FILE" > "$RAW_FILE"

  # Elasticsearch can return HTTP success with partial shard failures. Treat
  # that as a failed poll: an empty result is unsafe when one alert shard never
  # participated in the query. `_id` is deliberately not used as a tiebreaker
  # because modern Security Onion Elasticsearch disables `_id` fielddata.
  if ! jq -e '
    (.error? == null)
    and ((._shards.failed // 0) == 0)
    and (.hits.hits | type == "array")
  ' "$RAW_FILE" >/dev/null; then
    echo "Security Onion alert query failed or returned failed shards" >&2
    jq -c '{
      error: (.error // null),
      failed_shards: (._shards.failed // null),
      shard_failures: [._shards.failures[]? | {
        index,
        type: (.reason.type // null),
        reason: (.reason.reason // null)
      }]
    }' "$RAW_FILE" >&2 || true
    exit 1
  fi

  PAGE_COUNT=$(jq '.hits.hits | length' "$RAW_FILE")
  TOTAL=$(jq -r '.hits.total.value // .hits.total // 0' "$RAW_FILE")
  jq -s '.[0] + .[1]' "$HITS_FILE" <(jq '.hits.hits' "$RAW_FILE") > "$NEXT_HITS_FILE"
  mv "$NEXT_HITS_FILE" "$HITS_FILE"
  FETCHED=$((FETCHED + PAGE_COUNT))
  PAGES=$((PAGES + 1))
  if (( PAGE_COUNT < SIZE || PAGE_COUNT == 0 || FETCHED >= MAX_TOTAL )); then
    break
  fi
  SEARCH_AFTER=$(jq -c '.hits.hits[-1].sort // empty' "$RAW_FILE")
  if [[ -z "$SEARCH_AFTER" ]]; then
    break
  fi
done

SATURATED=false
if (( TOTAL > FETCHED )); then
  SATURATED=true
fi

# Normalize Security Onion's Elasticsearch response into the compact JSON schema
# consumed by relay/app/relay.py.
jq -c --arg exported_at "$(date -u '+%Y-%m-%d  %H:%M:%SZ')" \
  --arg lookback "$LOOKBACK" --argjson total "$TOTAL" --argjson fetched "$FETCHED" \
  --argjson pages "$PAGES" --argjson saturated "$SATURATED" '
{
  source: "security-onion",
  exported_at: $exported_at,
  query: {
    lookback: $lookback,
    fetched: $fetched,
    total: $total,
    pages: $pages,
    saturated: $saturated
  },
  alerts: [
    .[] | ._source as $s | {
      alert_id: (._index + ":" + ._id),
      elastic_id: ._id,
      elastic_index: ._index,
      timestamp: $s["@timestamp"],
      message: (($s.message | fromjson? | .alert.signature) // $s.message // $s.rule.name // null),
      tags: ($s.tags // []),
      labels: ($s.labels // {}),
      sensor: ($s.observer.name // null),
      host: ($s.host.name // null),
      event_dataset: ($s.event.dataset // null),
      event_category: ($s.event.category // null),
      event_module: ($s.event.module // null),
      severity: ($s.event.severity // $s.rule.severity // null),
      severity_label: ($s.event.severity_label // null),
      rule_name: ($s.rule.name // null),
      rule_id: ($s.rule.uuid // null),
      rule_category: ($s.rule.category // null),
      rule_action: ($s.rule.action // null),
      rule_ruleset: ($s.rule.ruleset // null),
      rule_reference: ($s.rule.reference // null),
      rule_metadata: ($s.rule.metadata // {}),
      source: {
        ip: ($s.source.ip // null),
        port: ($s.source.port // null),
        asn: ($s.source.as.number // null),
        org: ($s.source.as.organization.name // null),
        country: ($s.source.geo.country_iso_code // null)
      },
      destination: {
        ip: ($s.destination.ip // null),
        port: ($s.destination.port // null),
        asn: ($s.destination.as.number // null),
        org: ($s.destination.as.organization.name // null),
        country: ($s.destination.geo.country_iso_code // null)
      },
      network: {
        transport: ($s.network.transport // null),
        community_id: ($s.network.community_id // null),
        vlan: ($s.network.vlan.id // null),
        public_ip: ($s.network.public_ip // []),
        private_ip: ($s.network.private_ip // [])
      },
      observer: {
        name: ($s.observer.name // null),
        ingress_interface: ($s.observer.ingress.interface.name // null)
      },
      ecs: ($s.ecs // {}),
      agent: ($s.agent // {}),
      log: ($s.log // {}),
      dns: ($s.dns // {}),
      http: ($s.http // {}),
      url: ($s.url // {}),
      tls: ($s.tls // {}),
      file: ($s.file // {}),
      process: ($s.process // {}),
      user: ($s.user // {}),
      related: ($s.related // {}),
      threat: ($s.threat // {}),
      zeek: ($s.zeek // {}),
      suricata: ($s.suricata // {}),
      security_onion: {
        raw_event: $s,
        enrichment_note: "Full-fidelity Security Onion alert document. Packet, payload, PCAP, and HTTP body fields are retained when present."
      }
    }
  ]
}
' "$HITS_FILE"
