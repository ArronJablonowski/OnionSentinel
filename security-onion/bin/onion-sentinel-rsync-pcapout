#!/usr/bin/env python3
"""Read-only forced-command wrapper for Onion Sentinel PCAP artifact rsync.

Install this as the forced command for the dedicated PCAP transfer SSH key on
Security Onion. It permits rsync sender mode only for files under
/nsm/pcapout/onion-sentinel and rejects shells, writes, wildcards, and paths
outside that artifact directory.
"""
from __future__ import annotations

import json
import os
import shlex
import shutil
import sys
from pathlib import Path


OUTPUT_ROOT = Path(os.environ.get("ONION_SENTINEL_PCAP_OUTPUT_ROOT", "/nsm/pcapout/onion-sentinel"))


def reject(reason: str, code: int = 1) -> None:
    print(json.dumps({"ok": False, "status": "rejected", "error": reason}, sort_keys=True), file=sys.stderr)
    raise SystemExit(code)


def validate_path(raw_path: str) -> Path:
    path = Path(raw_path)
    try:
        resolved = path.resolve(strict=False)
        root = OUTPUT_ROOT.resolve(strict=False)
    except OSError:
        reject("invalid artifact path")
    if not str(resolved).startswith(str(root) + os.sep):
        reject("artifact path escaped output root")
    if resolved.suffix != ".tar":
        reject("artifact path must be a tar file")
    if any(char in raw_path for char in "*?[]{}"):
        reject("wildcards are not permitted")
    return resolved


def main() -> int:
    original = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    if not original:
        reject("interactive sessions are not permitted")
    try:
        args = shlex.split(original)
    except ValueError as exc:
        reject(f"invalid rsync command: {exc}")
    if not args or Path(args[0]).name != "rsync":
        reject("only rsync is permitted")
    if "--server" not in args or "--sender" not in args:
        reject("only read-only rsync sender mode is permitted")
    if "--daemon" in args:
        reject("rsync daemon mode is not permitted")
    if any(arg in {"--delete", "--remove-source-files"} for arg in args):
        reject("destructive rsync options are not permitted")
    artifact = validate_path(args[-1])
    if not artifact.exists() or not artifact.is_file():
        reject("artifact file does not exist")
    rsync = shutil.which("rsync") or "/usr/bin/rsync"
    os.execv(rsync, ["rsync", *args[1:]])
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
