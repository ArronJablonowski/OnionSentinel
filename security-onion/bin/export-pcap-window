#!/usr/bin/env python3
"""Bounded PCAP extraction wrapper for Onion Sentinel.

Reads one JSON request from stdin, validates network tuple and time bounds, and
writes a tar artifact containing tcpdump-filtered pcap parts under
/nsm/pcapout/onion-sentinel. The wrapper prints metadata JSON only; packet
contents never go to stdout/stderr.
"""
from __future__ import annotations

import hashlib
import ipaddress
import json
import os
import re
import resource
import shutil
import subprocess
import sys
import tarfile
from datetime import datetime, timedelta, timezone
from pathlib import Path


PCAP_ROOT = Path(os.environ.get("ONION_SENTINEL_PCAP_ROOT", "/nsm/suripcap"))
OUTPUT_ROOT = Path(os.environ.get("ONION_SENTINEL_PCAP_OUTPUT_ROOT", "/nsm/pcapout/onion-sentinel"))
MAX_WINDOW_SECONDS = int(os.environ.get("ONION_SENTINEL_PCAP_MAX_WINDOW_SECONDS", "300"))
MAX_LOOKBACK_HOURS = int(os.environ.get("ONION_SENTINEL_PCAP_MAX_LOOKBACK_HOURS", "24"))
MAX_CANDIDATE_FILES = int(os.environ.get("ONION_SENTINEL_PCAP_MAX_CANDIDATE_FILES", "80"))
MAX_ARTIFACT_BYTES = int(os.environ.get("ONION_SENTINEL_PCAP_MAX_ARTIFACT_BYTES", str(32 * 1024 * 1024 * 1024)))
TRANSFER_GROUP = os.environ.get("ONION_SENTINEL_PCAP_TRANSFER_GROUP", "so-ai-relay-pcap-rsync")
def fail(reason: str, code: int = 1, diagnostics: dict | None = None) -> None:
    """Return a bounded failure record without exposing packet contents."""
    payload = {"ok": False, "status": "failed", "error": reason}
    if diagnostics:
        payload["diagnostics"] = diagnostics
    print(json.dumps(payload, sort_keys=True))
    raise SystemExit(code)


def clean_token(value: object, max_len: int = 200) -> str:
    return str(value or "").strip()[:max_len]


def parse_time(value: object) -> datetime:
    raw = clean_token(value, 80).replace("  ", "T")
    if raw.endswith("Z"):
        raw = f"{raw[:-1]}+00:00"
    try:
        parsed = datetime.fromisoformat(raw)
    except ValueError:
        fail(f"invalid timestamp: {value}")
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def parse_port(value: object) -> int | None:
    if value in (None, ""):
        return None
    try:
        port = int(value)
    except (TypeError, ValueError):
        fail(f"invalid port: {value}")
    if port < 1 or port > 65535:
        fail(f"port out of range: {port}")
    return port


def safe_request_id(value: object) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9_.-]+", "_", clean_token(value, 80)).strip("._")
    return cleaned or datetime.now(timezone.utc).strftime("pcap-%Y%m%dT%H%M%SZ")


def bpf_for_request(req: dict, vlan: bool = False) -> str:
    src = str(ipaddress.ip_address(clean_token(req.get("source_ip"), 64)))
    dst = str(ipaddress.ip_address(clean_token(req.get("destination_ip"), 64)))
    src_port = parse_port(req.get("source_port"))
    dst_port = parse_port(req.get("destination_port"))
    parts = [f"host {src}", f"host {dst}"]
    # Source ports are usually ephemeral and can make brokered PCAP retrieval too
    # brittle when a grouped alert uses a representative row. Keep destination
    # service port as the default discriminator; require_source_port is available
    # for rare cases where the operator intentionally wants a single flow.
    if src_port and req.get("require_source_port"):
        parts.append(f"port {src_port}")
    if dst_port:
        parts.append(f"port {dst_port}")
    bpf = " and ".join(parts)
    return f"vlan and {bpf}" if vlan else bpf


def requested_capture_file(req: dict) -> Path | None:
    raw = clean_token(req.get("capture_file"), 512)
    if not raw:
        return None
    path = Path(raw)
    try:
        resolved = path.resolve(strict=False)
        root = PCAP_ROOT.resolve(strict=False)
    except OSError:
        return None
    if not str(resolved).startswith(str(root) + os.sep):
        fail("capture_file is outside the Security Onion PCAP root")
    if not resolved.name.startswith("so-pcap."):
        fail("capture_file must reference a Security Onion so-pcap file")
    return resolved


def capture_epoch(path: Path) -> int | None:
    """Read Security Onion's capture-start epoch from a rotated PCAP filename."""
    match = re.fullmatch(r"so-pcap\.(\d+)", path.name)
    if not match:
        return None
    try:
        return int(match.group(1))
    except ValueError:
        return None


def candidate_files(start: datetime, end: datetime, req: dict | None = None) -> list[Path]:
    """Choose captures nearest the alert window, not the newest captures on disk.

    The prior mtime-based method was correct only while an alert was fresh. A
    historical backfill could instead inspect the newest captures in the
    retention pool. Security Onion names its rotating files with their capture
    epoch, so use that stable event-time signal and retain the requested file as
    a preferred hint when it is still available.
    """
    lookback_seconds = max(3600, MAX_LOOKBACK_HOURS * 3600)
    lower_epoch = int(start.timestamp()) - lookback_seconds
    upper_epoch = int(end.timestamp()) + 3600
    find_cmd = [
        "find",
        str(PCAP_ROOT),
        "-type",
        "f",
        "-name",
        "so-pcap.*",
        "-printf", "%f\t%p\n",
    ]
    result = subprocess.run(find_cmd, check=False, capture_output=True, text=True, timeout=30)
    if result.returncode != 0:
        fail("failed to enumerate pcap files")
    files: list[tuple[int, Path]] = []
    for line in result.stdout.splitlines():
        try:
            name, raw_path = line.split("\t", 1)
        except ValueError:
            continue
        path = Path(raw_path)
        epoch = capture_epoch(Path(name))
        if epoch is None or epoch < lower_epoch or epoch > upper_epoch:
            continue
        files.append((epoch, path))
    reference_epoch = int(end.timestamp())
    files.sort(key=lambda item: (abs(item[0] - reference_epoch), -item[0], str(item[1])))
    candidates = [path for _, path in files[:MAX_CANDIDATE_FILES]]
    if req:
        capture_file = requested_capture_file(req)
        if capture_file and capture_file.exists():
            candidates = [capture_file] + [path for path in candidates if path != capture_file]
    return candidates


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def output_child(path: Path) -> Path:
    resolved = path.resolve(strict=False)
    output_root = OUTPUT_ROOT.resolve(strict=False)
    if not str(resolved).startswith(str(output_root) + os.sep):
        fail("artifact path escaped output root")
    return resolved


def prepare_output_root() -> None:
    OUTPUT_ROOT.mkdir(parents=True, exist_ok=True)
    try:
        shutil.chown(OUTPUT_ROOT, group=TRANSFER_GROUP)
    except (LookupError, PermissionError, OSError):
        # Export can still run in isolated test/dev environments that have not
        # created the transfer group. Production installs should create it.
        pass
    OUTPUT_ROOT.chmod(0o750)


def reusable_artifact_payload(request_id: str) -> dict | None:
    """Return metadata for a complete prior export without touching rolling PCAP.

    Relay retries must survive source-PCAP retention. Only regular, bounded tar
    files containing the wrapper's flat `part-*.pcap` members are reusable.
    """
    artifact = OUTPUT_ROOT / f"{request_id}.tar"
    if not artifact.is_file() or artifact.is_symlink():
        return None
    size = artifact.stat().st_size
    if size <= 0 or size > MAX_ARTIFACT_BYTES:
        return None
    try:
        with tarfile.open(artifact, "r") as archive:
            members = [member for member in archive.getmembers() if member.isfile()]
            if not members:
                return None
            for member in members:
                name = Path(member.name)
                if name.name != member.name or not re.fullmatch(r"part-[0-9]{3}\.pcap", member.name):
                    return None
    except (OSError, tarfile.TarError):
        return None
    return {
        "ok": True,
        "status": "fulfilled",
        "request_id": request_id,
        "artifact_path": str(artifact),
        "artifact_sha256": sha256_file(artifact),
        "artifact_size_bytes": size,
        "part_count": len(members),
        "reused_existing_artifact": True,
    }


def limit_output_file_size(max_bytes: int) -> None:
    """Prevent tcpdump from filling Security Onion export storage on a dense flow."""
    safe_limit = max(1, int(max_bytes))
    resource.setrlimit(resource.RLIMIT_FSIZE, (safe_limit, safe_limit))


def remove_request_outputs(request_id: str) -> list[str]:
    """Remove only one request's tar and work directory."""
    artifact = output_child(OUTPUT_ROOT / f"{request_id}.tar")
    work_dir = output_child(OUTPUT_ROOT / request_id)
    removed: list[str] = []

    if artifact.exists():
        if not artifact.is_file():
            fail("artifact cleanup target is not a file")
        artifact.unlink()
        removed.append(str(artifact))
    if work_dir.exists():
        if not work_dir.is_dir():
            fail("artifact work target is not a directory")
        shutil.rmtree(work_dir)
        removed.append(str(work_dir))
    return removed


def cleanup_artifact(req: dict) -> int:
    request_id = safe_request_id(req.get("request_id"))
    removed = remove_request_outputs(request_id)

    print(
        json.dumps(
            {
                "ok": True,
                "status": "artifact_cleaned",
                "request_id": request_id,
                "removed": removed,
            },
            sort_keys=True,
        )
    )
    return 0


def main() -> int:
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError as exc:
        fail(f"invalid JSON: {exc}")
    if not isinstance(req, dict):
        fail("request must be a JSON object")
    mode = clean_token(req.get("mode"), 40)
    if mode == "artifact_cleanup":
        return cleanup_artifact(req)
    if mode:
        fail(f"unsupported mode: {mode}")

    request_id = safe_request_id(req.get("request_id"))
    first_seen = parse_time(req.get("first_seen"))
    last_seen = parse_time(req.get("last_seen"))
    requested_window = parse_port(req.get("max_window_seconds")) or 120
    window_seconds = max(30, min(MAX_WINDOW_SECONDS, requested_window))
    duration = max(0, int((last_seen - first_seen).total_seconds()))
    if duration > window_seconds:
        start = last_seen - timedelta(seconds=window_seconds)
        end = last_seen
    else:
        pad = max(0, (window_seconds - duration) // 2)
        start = first_seen - timedelta(seconds=pad)
        end = last_seen + timedelta(seconds=pad)

    bpf_variants = [bpf_for_request(req)]
    vlan_bpf = bpf_for_request(req, vlan=True)
    if vlan_bpf not in bpf_variants:
        bpf_variants.insert(0, vlan_bpf)
    prepare_output_root()
    existing = reusable_artifact_payload(request_id)
    if existing:
        print(json.dumps(existing, sort_keys=True))
        return 0
    work_dir = OUTPUT_ROOT / request_id
    if work_dir.exists():
        shutil.rmtree(work_dir)
    work_dir.mkdir(mode=0o750)

    candidates = candidate_files(start, end, req)
    diagnostics = {
        "search_strategy": "capture-epoch-near-window",
        "window_start": start.strftime("%Y-%m-%d  %H:%M:%S%z"),
        "window_end": end.strftime("%Y-%m-%d  %H:%M:%S%z"),
        "candidate_count": len(candidates),
        "candidate_files": [path.name for path in candidates[:20]],
        "requested_capture_file": requested_capture_file(req).name if requested_capture_file(req) else None,
        "bpf_variants": bpf_variants,
    }
    part_paths: list[Path] = []
    part_bytes = 0
    size_limit_hit = False
    part_index = 1
    for pcap in candidates:
        for bpf in bpf_variants:
            remaining_bytes = MAX_ARTIFACT_BYTES - part_bytes
            if remaining_bytes <= 24:
                size_limit_hit = True
                break
            part = work_dir / f"part-{part_index:03d}.pcap"
            part_index += 1
            cmd = ["tcpdump", "-r", str(pcap), "-w", str(part), bpf]
            result = subprocess.run(
                cmd,
                check=False,
                capture_output=True,
                text=True,
                timeout=60,
                preexec_fn=lambda: limit_output_file_size(remaining_bytes),
            )
            if result.returncode not in (0, 1):
                if part.exists() and part.stat().st_size >= remaining_bytes:
                    size_limit_hit = True
                    part.unlink()
                continue
            if part.exists() and part.stat().st_size > 24:
                part_size = part.stat().st_size
                if part_size > remaining_bytes:
                    size_limit_hit = True
                    part.unlink()
                    continue
                part_paths.append(part)
                part_bytes += part_size
                break
            elif part.exists():
                part.unlink()

    if not part_paths:
        reason = "PCAP extraction exceeded artifact size limit" if size_limit_hit else "no matching packets found"
        remove_request_outputs(request_id)
        fail(reason, code=2, diagnostics=diagnostics)

    artifact = OUTPUT_ROOT / f"{request_id}.tar"
    with tarfile.open(artifact, "w") as tar:
        for part in part_paths:
            tar.add(part, arcname=part.name)

    artifact_size = artifact.stat().st_size
    if artifact_size > MAX_ARTIFACT_BYTES:
        remove_request_outputs(request_id)
        fail("PCAP artifact exceeds configured size limit", diagnostics=diagnostics)
    try:
        shutil.chown(artifact, group=TRANSFER_GROUP)
        artifact.chmod(0o640)
    except (LookupError, PermissionError, OSError):
        artifact.chmod(0o600)
    payload = {
        "ok": True,
        "status": "fulfilled",
        "request_id": request_id,
        "artifact_path": str(artifact),
        "artifact_sha256": sha256_file(artifact),
        "artifact_size_bytes": artifact_size,
        "part_count": len(part_paths),
        "window_start": start.strftime("%Y-%m-%d  %H:%M:%S%z"),
        "window_end": end.strftime("%Y-%m-%d  %H:%M:%S%z"),
    }
    print(json.dumps(payload, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
