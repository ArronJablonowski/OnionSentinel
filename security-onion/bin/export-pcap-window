#!/usr/bin/env python3
"""Bounded PCAP extraction wrapper for Onion Sentinel.

Reads one JSON request from stdin, validates network tuple and time bounds, and
writes a tar artifact containing tcpdump-filtered pcap parts under
/nsm/pcapout/onion-sentinel. The wrapper prints metadata JSON only; packet
contents never go to stdout/stderr.
"""
from __future__ import annotations

import hashlib
import ipaddress
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
from datetime import datetime, timedelta, timezone
from pathlib import Path


PCAP_ROOT = Path(os.environ.get("ONION_SENTINEL_PCAP_ROOT", "/nsm/suripcap"))
OUTPUT_ROOT = Path(os.environ.get("ONION_SENTINEL_PCAP_OUTPUT_ROOT", "/nsm/pcapout/onion-sentinel"))
MAX_WINDOW_SECONDS = int(os.environ.get("ONION_SENTINEL_PCAP_MAX_WINDOW_SECONDS", "300"))
MAX_LOOKBACK_HOURS = int(os.environ.get("ONION_SENTINEL_PCAP_MAX_LOOKBACK_HOURS", "24"))
MAX_CANDIDATE_FILES = int(os.environ.get("ONION_SENTINEL_PCAP_MAX_CANDIDATE_FILES", "80"))
TRANSFER_GROUP = os.environ.get("ONION_SENTINEL_PCAP_TRANSFER_GROUP", "so-ai-relay-pcap-rsync")
def fail(reason: str, code: int = 1) -> None:
    print(json.dumps({"ok": False, "status": "failed", "error": reason}, sort_keys=True))
    raise SystemExit(code)


def clean_token(value: object, max_len: int = 200) -> str:
    return str(value or "").strip()[:max_len]


def parse_time(value: object) -> datetime:
    raw = clean_token(value, 80).replace("  ", "T")
    if raw.endswith("Z"):
        raw = f"{raw[:-1]}+00:00"
    try:
        parsed = datetime.fromisoformat(raw)
    except ValueError:
        fail(f"invalid timestamp: {value}")
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def parse_port(value: object) -> int | None:
    if value in (None, ""):
        return None
    try:
        port = int(value)
    except (TypeError, ValueError):
        fail(f"invalid port: {value}")
    if port < 1 or port > 65535:
        fail(f"port out of range: {port}")
    return port


def safe_request_id(value: object) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9_.-]+", "_", clean_token(value, 80)).strip("._")
    return cleaned or datetime.now(timezone.utc).strftime("pcap-%Y%m%dT%H%M%SZ")


def bpf_for_request(req: dict, vlan: bool = False) -> str:
    src = str(ipaddress.ip_address(clean_token(req.get("source_ip"), 64)))
    dst = str(ipaddress.ip_address(clean_token(req.get("destination_ip"), 64)))
    src_port = parse_port(req.get("source_port"))
    dst_port = parse_port(req.get("destination_port"))
    parts = [f"host {src}", f"host {dst}"]
    # Source ports are usually ephemeral and can make brokered PCAP retrieval too
    # brittle when a grouped alert uses a representative row. Keep destination
    # service port as the default discriminator; require_source_port is available
    # for rare cases where the operator intentionally wants a single flow.
    if src_port and req.get("require_source_port"):
        parts.append(f"port {src_port}")
    if dst_port:
        parts.append(f"port {dst_port}")
    bpf = " and ".join(parts)
    return f"vlan and {bpf}" if vlan else bpf


def requested_capture_file(req: dict) -> Path | None:
    raw = clean_token(req.get("capture_file"), 512)
    if not raw:
        return None
    path = Path(raw)
    try:
        resolved = path.resolve(strict=False)
        root = PCAP_ROOT.resolve(strict=False)
    except OSError:
        return None
    if not str(resolved).startswith(str(root) + os.sep):
        fail("capture_file is outside the Security Onion PCAP root")
    if not resolved.name.startswith("so-pcap."):
        fail("capture_file must reference a Security Onion so-pcap file")
    return resolved


def candidate_files(start: datetime, end: datetime, req: dict | None = None) -> list[Path]:
    now = datetime.now(timezone.utc)
    lookback_seconds = max(3600, min(MAX_LOOKBACK_HOURS * 3600, int((now - start).total_seconds()) + 3600))
    find_cmd = [
        "find",
        str(PCAP_ROOT),
        "-type",
        "f",
        "-name",
        "so-pcap.*",
        "-mmin",
        f"-{max(1, lookback_seconds // 60)}",
        "-printf",
        "%T@ %p\n",
    ]
    result = subprocess.run(find_cmd, check=False, capture_output=True, text=True, timeout=30)
    if result.returncode != 0:
        fail("failed to enumerate pcap files")
    files: list[tuple[float, Path]] = []
    for line in result.stdout.splitlines():
        try:
            raw_mtime, path = line.split(" ", 1)
            mtime = float(raw_mtime)
        except (TypeError, ValueError):
            continue
        files.append((mtime, Path(path)))
    files.sort(key=lambda item: item[0])
    candidates = [path for _, path in files[-MAX_CANDIDATE_FILES:]]
    if req:
        capture_file = requested_capture_file(req)
        if capture_file and capture_file.exists():
            candidates = [capture_file] + [path for path in candidates if path != capture_file]
    return candidates


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def output_child(path: Path) -> Path:
    resolved = path.resolve(strict=False)
    output_root = OUTPUT_ROOT.resolve(strict=False)
    if not str(resolved).startswith(str(output_root) + os.sep):
        fail("artifact path escaped output root")
    return resolved


def prepare_output_root() -> None:
    OUTPUT_ROOT.mkdir(parents=True, exist_ok=True)
    try:
        shutil.chown(OUTPUT_ROOT, group=TRANSFER_GROUP)
        OUTPUT_ROOT.chmod(0o750)
    except (LookupError, PermissionError, OSError):
        # Export can still run in isolated test/dev environments that have not
        # created the transfer group. Production installs should create it.
        pass


def cleanup_artifact(req: dict) -> int:
    request_id = safe_request_id(req.get("request_id"))
    artifact = output_child(OUTPUT_ROOT / f"{request_id}.tar")
    work_dir = output_child(OUTPUT_ROOT / request_id)
    removed: list[str] = []

    if artifact.exists():
        if not artifact.is_file():
            fail("artifact cleanup target is not a file")
        artifact.unlink()
        removed.append(str(artifact))
    if work_dir.exists():
        if not work_dir.is_dir():
            fail("artifact work target is not a directory")
        shutil.rmtree(work_dir)
        removed.append(str(work_dir))

    print(
        json.dumps(
            {
                "ok": True,
                "status": "artifact_cleaned",
                "request_id": request_id,
                "removed": removed,
            },
            sort_keys=True,
        )
    )
    return 0


def main() -> int:
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError as exc:
        fail(f"invalid JSON: {exc}")
    if not isinstance(req, dict):
        fail("request must be a JSON object")
    mode = clean_token(req.get("mode"), 40)
    if mode == "artifact_cleanup":
        return cleanup_artifact(req)
    if mode:
        fail(f"unsupported mode: {mode}")

    request_id = safe_request_id(req.get("request_id"))
    first_seen = parse_time(req.get("first_seen"))
    last_seen = parse_time(req.get("last_seen"))
    requested_window = parse_port(req.get("max_window_seconds")) or 120
    window_seconds = max(30, min(MAX_WINDOW_SECONDS, requested_window))
    duration = max(0, int((last_seen - first_seen).total_seconds()))
    if duration > window_seconds:
        start = last_seen - timedelta(seconds=window_seconds)
        end = last_seen
    else:
        pad = max(0, (window_seconds - duration) // 2)
        start = first_seen - timedelta(seconds=pad)
        end = last_seen + timedelta(seconds=pad)

    bpf_variants = [bpf_for_request(req)]
    vlan_bpf = bpf_for_request(req, vlan=True)
    if vlan_bpf not in bpf_variants:
        bpf_variants.insert(0, vlan_bpf)
    prepare_output_root()
    work_dir = OUTPUT_ROOT / request_id
    if work_dir.exists():
        shutil.rmtree(work_dir)
    work_dir.mkdir(mode=0o750)

    part_paths: list[Path] = []
    part_index = 1
    for pcap in candidate_files(start, end, req):
        for bpf in bpf_variants:
            part = work_dir / f"part-{part_index:03d}.pcap"
            part_index += 1
            cmd = ["tcpdump", "-r", str(pcap), "-w", str(part), bpf]
            result = subprocess.run(cmd, check=False, capture_output=True, text=True, timeout=60)
            if result.returncode not in (0, 1):
                continue
            if part.exists() and part.stat().st_size > 24:
                part_paths.append(part)
                break
            elif part.exists():
                part.unlink()

    if not part_paths:
        fail("no matching packets found", code=2)

    artifact = OUTPUT_ROOT / f"{request_id}.tar"
    with tarfile.open(artifact, "w") as tar:
        for part in part_paths:
            tar.add(part, arcname=part.name)

    artifact_size = artifact.stat().st_size
    try:
        shutil.chown(artifact, group=TRANSFER_GROUP)
        artifact.chmod(0o640)
    except (LookupError, PermissionError, OSError):
        artifact.chmod(0o600)
    payload = {
        "ok": True,
        "status": "fulfilled",
        "request_id": request_id,
        "artifact_path": str(artifact),
        "artifact_sha256": sha256_file(artifact),
        "artifact_size_bytes": artifact_size,
        "part_count": len(part_paths),
        "window_start": start.strftime("%Y-%m-%d  %H:%M:%S%z"),
        "window_end": end.strftime("%Y-%m-%d  %H:%M:%S%z"),
    }
    print(json.dumps(payload, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
