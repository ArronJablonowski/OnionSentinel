# Copy to $HOME/n8n-local/.env on the Mac Studio.
# Do not commit the real file.

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
TELEGRAM_ALERT_LEVELS=critical,high
TELEGRAM_COOLDOWN_SECONDS=900
SOC_ALERTS_PORTAL_DIR=__HOME__/report_portal/library/Cybersecurity/SOC Alerts

# Optional public enrichment API keys.
# Leave blank or placeholder-valued to skip that enrichment source safely.
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
OTX_API_KEY=
URLHAUS_AUTH_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=
MALWAREBAZAAR_AUTH_KEY=
THREATFOX_AUTH_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
CENSYS_API_TOKEN=
CENSYS_ORGANIZATION_ID=
NVD_API_KEY=

# Enrichment behavior.
ENRICHMENT_CACHE_TTL_SECONDS=86400
ENRICHMENT_VULN_CACHE_TTL_SECONDS=86400
ENRICHMENT_TIMEOUT_MS=5000
VIRUSTOTAL_MINIMUM_LEVEL=high
URLSCAN_SUBMIT_ENABLED=false

# Alert-store ingestion safety.
ALERT_STORE_MAX_REQUEST_BYTES=5242880
ALERT_STORE_SQLITE_BUSY_TIMEOUT_MS=10000
ALERT_STORE_SQLITE_JOURNAL_MODE=DELETE
ALERT_STORE_SQLITE_SYNCHRONOUS=NORMAL
ALERT_STORE_SQLITE_TEMP_STORE=DEFAULT

# PCAP request broker safety.
# Requests are queued in SQLite for relay/Security Onion fulfillment; alert-store
# itself never connects to Security Onion or exports packet captures.
PCAP_REQUEST_DEFAULT_WINDOW_SECONDS=120
PCAP_REQUEST_MAX_WINDOW_SECONDS=300
