# Copy to $HOME/n8n-local/.env on the Mac Studio.
# Do not commit the real file.

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
TELEGRAM_ALERT_LEVELS=critical,high
TELEGRAM_COOLDOWN_SECONDS=900
SOC_ALERTS_PORTAL_DIR=__HOME__/report_portal/library/Cybersecurity/SOC Alerts

# n8n internal PostgreSQL runtime database.
# This is separate from alert-store's SQLite database. Replace the password in
# the live Mac Studio .env only; never commit real credentials.
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=replace-with-n8n-postgres-password

# Optional public enrichment API keys.
# Leave blank or placeholder-valued to skip that enrichment source safely.
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
OTX_API_KEY=
URLHAUS_AUTH_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=
MALWAREBAZAAR_AUTH_KEY=
THREATFOX_AUTH_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
CENSYS_API_TOKEN=
CENSYS_ORGANIZATION_ID=
NVD_API_KEY=

# Enrichment behavior.
ENRICHMENT_CACHE_TTL_SECONDS=86400
ENRICHMENT_VULN_CACHE_TTL_SECONDS=86400
ENRICHMENT_TIMEOUT_MS=5000
ENRICHMENT_WORKER_INTERVAL_MS=5000
ENRICHMENT_WORKER_MAX_ATTEMPTS=8
VIRUSTOTAL_MINIMUM_LEVEL=high
URLSCAN_SUBMIT_ENABLED=false

# Alert-store ingestion safety.
# Must be large enough for normal alert and enrichment JSON. PCAP artifacts are
# transferred out-of-band by the relay SSD spool and rsync, not through n8n.
ALERT_STORE_MAX_REQUEST_BYTES=10485760
ALERT_STORE_SQLITE_BUSY_TIMEOUT_MS=30000
ALERT_STORE_SQLITE_JOURNAL_MODE=DELETE
ALERT_STORE_SQLITE_SYNCHRONOUS=FULL
ALERT_STORE_SQLITE_TEMP_STORE=DEFAULT

# PCAP request broker safety.
# Requests are queued in SQLite for relay/Security Onion fulfillment; alert-store
# itself never connects to Security Onion or exports packet captures.
PCAP_REQUEST_DEFAULT_WINDOW_SECONDS=120
PCAP_REQUEST_MAX_WINDOW_SECONDS=300
PCAP_CLAIM_LEASE_SECONDS=1800
# Set to the verified Security Onion rolling-capture horizon. Set 0 to disable
# the gate during initial testing; production should reject impossible backfill.
PCAP_CAPTURE_RETENTION_SECONDS=345600
PCAP_AUTO_REQUEST_LEVELS=critical,high,medium,low,informational
# Mac parser extraction budgets. These bound archive expansion before Zeek or
# TShark execute and are intentionally above the relay's 32 GiB artifact cap.
PCAP_MAX_ARCHIVE_MEMBERS=2048
PCAP_MAX_EXTRACTED_BYTES=42949672960
PCAP_MAX_FILES=256

# n8n internal execution retention.
# Keep bounded execution history for troubleshooting. n8n metadata now uses
# PostgreSQL in the compose template; alert-store remains SQLite.
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=5000
