# Copy to $HOME/n8n-local/.env on the Mac Studio.
# Do not commit the real file.

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
TELEGRAM_ALERT_LEVELS=critical,high
TELEGRAM_COOLDOWN_SECONDS=900
SOC_ALERTS_DASHBOARD_DIR=__HOME__/SOC Alerts Web

# n8n internal PostgreSQL runtime database.
# This is separate from alert-store's SQLite database. Replace the password in
# the live Mac Studio .env only; never commit real credentials.
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=replace-with-n8n-postgres-password

# Optional public enrichment API keys.
# Leave blank or placeholder-valued to skip that enrichment source safely.
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
OTX_API_KEY=
URLHAUS_AUTH_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=
MALWAREBAZAAR_AUTH_KEY=
THREATFOX_AUTH_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
CENSYS_API_TOKEN=
CENSYS_ORGANIZATION_ID=
NVD_API_KEY=

# Enrichment behavior.
ENRICHMENT_CACHE_TTL_SECONDS=86400
ENRICHMENT_VULN_CACHE_TTL_SECONDS=86400
ENRICHMENT_TIMEOUT_MS=5000
ALERT_STORE_HTTP_JSON_MAX_RESPONSE_BYTES=5242880
ENRICHMENT_WORKER_INTERVAL_MS=5000
ENRICHMENT_WORKER_MAX_ATTEMPTS=8
VIRUSTOTAL_MINIMUM_LEVEL=high
URLSCAN_SUBMIT_ENABLED=false

# Alert-store ingestion safety.
# Must be large enough for normal alert and enrichment JSON. PCAP artifacts are
# transferred out-of-band by the relay SSD spool and rsync, not through n8n.
ALERT_STORE_MAX_REQUEST_BYTES=10485760
ALERT_STORE_REQUEST_TIMEOUT_MS=30000
ALERT_STORE_HEADERS_TIMEOUT_MS=10000
ALERT_STORE_KEEPALIVE_TIMEOUT_MS=5000
ALERT_STORE_MAX_REQUESTS_PER_SOCKET=100
ALERT_STORE_MAX_CONNECTIONS=256
ALERT_STORE_MAX_ACTIVE_POSTS=32
ALERT_STORE_PROXY_CONNECT_TIMEOUT_MS=5000
ALERT_STORE_PROXY_IDLE_TIMEOUT_MS=60000
ALERT_STORE_PROXY_MAX_CONNECTIONS=256
ALERT_STORE_SQLITE_BUSY_TIMEOUT_MS=30000
ALERT_STORE_SQLITE_JOURNAL_MODE=DELETE
ALERT_STORE_SQLITE_SYNCHRONOUS=FULL
ALERT_STORE_SQLITE_TEMP_STORE=DEFAULT
PIPELINE_EVENT_RETENTION_HOURS=168
PIPELINE_DISK_SAMPLE_INTERVAL_SECONDS=300

# Durable post-commit n8n report delivery. Use the same live secret as the n8n
# RELAY_WEBHOOK_TOKEN variable; keep the real value only in the Mac runtime.
N8N_POST_COMMIT_URL=http://127.0.0.1:5678/webhook/onion-sentinel-committed-alert
N8N_POST_COMMIT_TOKEN=replace-with-relay-webhook-token
N8N_POST_COMMIT_INTERVAL_MS=5000
N8N_POST_COMMIT_TIMEOUT_MS=30000
N8N_POST_COMMIT_MAX_ATTEMPTS=12
N8N_POST_COMMIT_BASE_RETRY_SECONDS=15

# Durable worker leases. The AI scheduler renews its lease every minute while
# inference runs; expired jobs return to the retry queue with bounded backoff.
DURABLE_JOB_RECOVERY_INTERVAL_SECONDS=60
AI_ANALYSIS_JOB_LEASE_SECONDS=1800

# Local AI memory/output ceilings. These prevent malformed or unexpectedly
# large alert groups from being buffered without bound in worker memory.
SOC_AI_MAX_PROMPT_PACKAGE_BYTES=4194304
SOC_AI_SCHEDULER_MAX_STDOUT_BYTES=16777216
SOC_AI_SCHEDULER_MAX_STDERR_BYTES=2097152

# Filesystem wake signals for low-latency local workers. launchd also runs each
# worker every five minutes, so a missing event cannot strand durable work.
AI_ANALYSIS_WAKE_PATH=__HOME__/n8n-local/run/ai-analysis.wake
PCAP_ANALYSIS_WAKE_PATH=__HOME__/n8n-local/run/pcap-analysis.wake
SOC_DASHBOARD_WAKE_PATH=__HOME__/n8n-local/run/dashboard-refresh.wake

# PCAP request broker safety.
# Requests are queued in SQLite for relay/Security Onion fulfillment; alert-store
# itself never connects to Security Onion or exports packet captures.
PCAP_REQUEST_DEFAULT_WINDOW_SECONDS=120
PCAP_REQUEST_MAX_WINDOW_SECONDS=300
PCAP_CLAIM_LEASE_SECONDS=1800
PCAP_TRANSFER_MAX_ATTEMPTS=5
PCAP_TRANSFER_MAX_RETRY_SECONDS=1800
# Critical/high requests always remain preemptive. Older medium/low/info work
# switches to oldest-first after this bound so continuous arrivals cannot starve it.
PCAP_PRIORITY_MAX_WAIT_SECONDS=1200
# Set to the verified Security Onion rolling-capture horizon. Set 0 to disable
# the gate during initial testing; production should reject impossible backfill.
PCAP_CAPTURE_RETENTION_SECONDS=345600
PCAP_AUTO_REQUEST_LEVELS=critical,high,medium,low,informational
# Mac parser extraction budgets. These bound archive expansion before Zeek or
# TShark execute and are intentionally above the relay's 32 GiB artifact cap.
PCAP_MAX_ARCHIVE_MEMBERS=2048
PCAP_MAX_EXTRACTED_BYTES=42949672960
PCAP_MAX_FILES=256
# Deprecated legacy SSH fetch remains bounded for disaster recovery. Normal
# production transfer is the relay SSD spool plus rsync transport.
PCAP_MAX_REMOTE_ARTIFACT_BYTES=42949672960
PCAP_REMOTE_FETCH_TIMEOUT_SECONDS=3600

# Mac Studio disk admission policy. Disk-heavy jobs stop at 75 percent so the
# host retains headroom; 80 percent is the non-negotiable hard ceiling.
ONION_SENTINEL_DISK_START_MAX_USED_PERCENT=75
ONION_SENTINEL_DISK_HARD_MAX_USED_PERCENT=80
ONION_SENTINEL_DISK_MIN_FREE_BYTES=53687091200
ONION_SENTINEL_PCAP_INTAKE_MAX_ARTIFACT_BYTES=137438953472
# Alert-store admission uses separate names because it is a Node service.
# Heartbeats and completion metadata remain available after new intake stops.
ALERT_STORE_DISK_START_MAX_USED_PERCENT=75
ALERT_STORE_DISK_HARD_MAX_USED_PERCENT=80
ALERT_STORE_DISK_MIN_FREE_BYTES=53687091200

# n8n internal execution retention.
# Keep bounded execution history for troubleshooting. n8n metadata now uses
# PostgreSQL in the compose template; alert-store remains SQLite.
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=5000
