{
  "schema": "onion-sentinel-investigation-skill-manifest-v2",
  "id": "network.dns.triage",
  "version": "2.0.0-candidate.2",
  "artifact_digest": "81a87dc6efb9966d840098815abf93405a2fa66aae20252b95551435d86f0ca3",
  "lineage": {"source_revision": "59ef4ad", "predecessor_digest": "77b794032b151502accc553d2c3af4810f0db58dfbd32b2787a7ce36d0e1e59a"},
  "compatibility": {
    "harness_contract": "onion-sentinel-harness-job-envelope-v1",
    "policy_schema": "onion-sentinel-investigation-harness-policy-v1",
    "evidence_contract": "onion-sentinel-evidence-reference-contract-v1"
  },
  "maintainer": {"owner": "Onion Sentinel", "reviewed_at": "2026-08-03T18:00:00Z", "reviewer": "pending"},
  "roles": ["soc-analyst", "incident-responder", "threat-hunter"],
  "match": {
    "tasks": ["alert-triage", "incident-response", "reanalysis", "threat-hunt"],
    "protocols": ["dns"],
    "alert_families": ["dns"],
    "data_sources": ["suricata", "zeek.dns", "elastic", "oql"]
  },
  "objective": "Establish what DNS activity occurred in the validated alert window and whether it supports a malicious, suspicious, or benign explanation.",
  "capabilities": ["security-onion.events.query", "security-onion.oql.query", "suricata.events.read", "zeek.derived.query"],
  "safety": {"read_only": true, "active_operation": false, "sensitivity": "moderate", "requires_approval": false},
  "budgets": {"max_queries": 4, "max_rows": 1000, "max_bytes": 1048576, "timeout_seconds": 90},
  "preconditions": ["bounded event time exists", "at least one endpoint or DNS identifier exists", "deployed field catalog is available"],
  "required_evidence": ["alert identity", "sensor and time scope", "query coverage and truncation"],
  "query_templates": [
    {
      "id": "dns-alert-context",
      "backend": "elastic",
      "language": "query-dsl",
      "purpose": "Retrieve bounded DNS and alert events correlated by trusted time and endpoint scope.",
      "parameters": ["source_alias", "destination_alias", "start_time", "end_time"],
      "expected_fields": ["@timestamp", "source.ip", "destination.ip", "dns.query.name", "dns.query.type", "dns.response.code_name", "dns.resolved_ip", "network.community_id", "event.dataset"]
    },
    {
      "id": "dns-zeek-context",
      "backend": "zeek",
      "language": "broker-parameters",
      "purpose": "Correlate Zeek DNS observations using bounded flow and time identifiers.",
      "parameters": ["community_id", "source_alias", "start_time", "end_time"],
      "expected_fields": ["@timestamp", "source.ip", "destination.ip", "network.community_id", "dns.query.name", "dns.query.type", "dns.response.code_name", "dns.resolved_ip"]
    }
  ],
  "output_contract": {"schema": "onion-sentinel-skill-result-v1", "coverage_required": true, "truncation_required": true, "evidence_refs_required": true},
  "alternative_hypotheses": ["normal service discovery", "software update or telemetry", "CDN or shared infrastructure", "security product lookup", "malicious resolution or tunneling"],
  "stop_conditions": ["the discriminating question is answered with corroborated evidence", "the next pivot has low expected information value", "a budget or deadline is exhausted"],
  "confidence_limiters": ["missing resolver visibility", "retention gap", "truncated results", "encrypted DNS", "NAT or shared resolver attribution"],
  "known_false_positive_patterns": ["mDNS and local discovery", "browser and OS prefetch", "update/CDN lookups", "security tooling reputation lookups"],
  "verification": {"unit_tests": false, "replay_cases": 0, "independent_query_review": false, "adversarial_tests": false, "human_approved": false},
  "references": [
    {"title": "Security Onion 2.4 Elasticsearch", "url": "https://docs.securityonion.net/en/2.4/elasticsearch.html", "product_version": "2.4", "retrieved_at": "2026-08-03T18:00:00Z"},
    {"title": "Zeek DNS log", "url": "https://docs.zeek.org/en/current/logs/dns.html", "product_version": "current as reviewed", "retrieved_at": "2026-08-03T18:00:00Z"}
  ]
}
