    "harness_contract": "onion-sentinel-harness-job-envelope-v1",
    "policy_schema": "onion-sentinel-investigation-harness-policy-v1",
    "evidence_contract": "onion-sentinel-evidence-reference-contract-v1"
  },
  "maintainer": {
    "owner": "Onion Sentinel",
