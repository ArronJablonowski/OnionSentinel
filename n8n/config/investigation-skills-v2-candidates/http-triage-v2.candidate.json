  },
  "roles": [
    "soc-analyst",
    "incident-responder",
    "threat-hunter"
  ],
  "match": {
    "tasks": [
      "alert-triage",
      "incident-response",
      "reanalysis",
      "threat-hunt"
    ],
    "protocols": [
      "http"
    ],
    "alert_families": [
      "http",
      "web",
      "user-agent"
    ],
    "data_sources": [
      "suricata",
      "zeek.http",
      "elastic",
      "oql"
    ]
  },
  "objective": "Establish the bounded HTTP transaction and determine whether host, URI, method, user agent, response, and file context support a benign or harmful explanation.",
  "capabilities": [
    "security-onion.events.query",
    "security-onion.oql.query",
    "suricata.events.read",
    "zeek.derived.query"
  ],
  "safety": {
    "read_only": true,
    "active_operation": false,
    "sensitivity": "moderate",
    "requires_approval": false
  },
  "budgets": {
    "max_queries": 4,
    "max_rows": 1000,
    "max_bytes": 1048576,
    "timeout_seconds": 90
  },
  "preconditions": [
    "bounded event time exists",
    "at least one endpoint or DNS identifier exists",
    "deployed field catalog is available"
  ],
  "required_evidence": [
    "alert identity",
    "bounded HTTP flow and time scope",
    "request and response coverage"
  ],
  "positive_evidence": [
    "attributable method host URI status and transfer metadata corroborate the suspicious HTTP hypothesis",
    "bounded DNS TLS or file context confirms related malicious infrastructure or content behavior"
  ],
  "negative_evidence": [
    "successful complete HTTP context matches an approved update telemetry automation or scanner workflow",
    "covered request and response metadata refute the suspected behavior without contradictory evidence"
  ],
  "escalation_pivots": [
    "correlate the exact HTTP tuple with DNS TLS and file metadata",
    "compare the attributable host URI or user agent in an adjacent bounded window",
    "request application-owner review when body content is encrypted truncated or unavailable"
  ],
  "query_templates": [
    {
      "id": "http-event-context",
      "backend": "elastic",
      "language": "query-dsl",
      "purpose": "Retrieve bounded HTTP request, response, file, and alert observations.",
      "parameters": [
        "source_alias",
        "destination_alias",
        "start_time",
        "end_time"
      ],
      "expected_fields": [
        "@timestamp",
        "source.ip",
        "destination.ip",
        "http.method",
        "http.uri",
        "http.useragent",
        "http.status_code",
        "network.community_id"
      ]
    },
    {
      "id": "http-zeek-context",
      "backend": "zeek",
      "language": "broker-parameters",
      "purpose": "Correlate Zeek HTTP and file metadata using bounded identifiers.",
      "parameters": [
        "community_id",
        "source_alias",
        "start_time",
        "end_time"
      ],
      "expected_fields": [
        "@timestamp",
        "log.id.uid",
        "source.ip",
        "destination.ip",
        "http.virtual_host",
        "http.uri",
        "http.method",
        "http.useragent",
        "http.status_code",
        "file.resp_mime_types"
      ]
    }
  ],
  "output_contract": {
    "schema": "onion-sentinel-skill-result-v1",
    "coverage_required": true,
    "truncation_required": true,
    "evidence_refs_required": true,
    "fact_states": ["observed", "inferred", "unverified", "unavailable"]
  },
  "alternative_hypotheses": [
    "software update or telemetry",
    "authorized automation or scanner",
    "user browsing",
    "malicious download or callback"
  ],
  "stop_conditions": [
    "the discriminating question is answered with corroborated evidence",
    "the next pivot has low expected information value",
    "a budget or deadline is exhausted"
  ],
  "confidence_limiters": [
    "encrypted HTTPS without HTTP visibility",
    "missing response body metadata",
    "proxy or NAT attribution",
    "retention gap"
  ],
  "known_false_positive_patterns": [
    "update and telemetry traffic",
    "browser prefetch",
    "authorized vulnerability scanning",
    "package repository access"
  ],
  "verification": {
    "unit_tests": false,
    "replay_cases": 0,
    "independent_query_review": false,
    "adversarial_tests": false,
    "human_approved": false
  },
