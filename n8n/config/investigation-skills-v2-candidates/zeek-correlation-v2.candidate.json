      "elastic",
      "oql"
    ]
  },
  "objective": "Correlate a bounded network event through Zeek connection and protocol logs using trusted identifiers, while surfacing parser, retention, and routing gaps.",
  "capabilities": [
    "security-onion.events.query",
    "security-onion.oql.query",
    "zeek.derived.query"
  ],
  "safety": {
    "read_only": true,
    "active_operation": false,
    "sensitivity": "moderate",
    "requires_approval": false
  },
  "budgets": {
    "max_queries": 4,
    "max_rows": 1000,
    "max_bytes": 1048576,
    "timeout_seconds": 90
  },
  "preconditions": [
    "bounded event time exists",
    "at least one endpoint or DNS identifier exists",
    "deployed field catalog is available"
  ],
  "required_evidence": [
    "bounded time and endpoint scope",
    "UID community ID or five tuple",
    "sensor and parser coverage"
  ],
  "positive_evidence": [
    "the same attributable UID or community ID links connection and protocol observations",
    "correlated protocol records independently corroborate the hypothesized sequence"
  ],
  "negative_evidence": [
    "successful complete correlation shows only expected protocol activity for the exact tuple and window",
    "covered parser and sensor evidence refutes the suspected cross-log relationship"
  ],
  "escalation_pivots": [
    "anchor the exact Zeek connection by UID community ID or role-safe tuple",
    "retrieve only protocol records linked to the validated anchor",
    "investigate parser retention or asymmetric-routing gaps before interpreting absence"
  ],
  "query_templates": [
    {
      "id": "zeek-connection-anchor",
      "backend": "zeek",
      "language": "broker-parameters",
      "purpose": "Anchor correlation in the Zeek connection record using UID, community ID, or bounded five tuple.",
      "parameters": [
        "community_id",
        "source_alias",
        "destination_alias",
        "start_time",
        "end_time"
      ],
      "expected_fields": [
        "@timestamp",
        "event.dataset",
        "source.ip",
        "source.port",
        "destination.ip",
        "destination.port",
        "network.transport",
        "network.protocol",
        "network.community_id",
        "event.duration"
      ]
    },
    {
      "id": "zeek-protocol-pivots",
      "backend": "zeek",
      "language": "broker-parameters",
      "purpose": "Retrieve only protocol records linked to the validated Zeek connection anchors.",
      "parameters": [
        "uid",
        "community_id",
        "start_time",
        "end_time"
      ],
      "expected_fields": [
        "@timestamp",
        "event.dataset",
        "source.ip",
        "destination.ip",
        "network.transport",
        "network.protocol",
        "network.community_id"
      ]
    }
  ],
  "output_contract": {
    "schema": "onion-sentinel-skill-result-v1",
    "coverage_required": true,
    "truncation_required": true,
    "evidence_refs_required": true,
    "fact_states": ["observed", "inferred", "unverified", "unavailable"]
  },
  "alternative_hypotheses": [
    "normal protocol activity",
    "parser or retention gap",
    "asymmetric routing",
    "malicious behavior corroborated across logs"
  ],
  "stop_conditions": [
    "the discriminating question is answered with corroborated evidence",
    "the next pivot has low expected information value",
    "a budget or deadline is exhausted"
  ],
  "confidence_limiters": [
    "missing UID or community ID",
    "asymmetric visibility",
    "parser failure",
    "retention mismatch"
  ],
  "known_false_positive_patterns": [
    "ordinary client-server sessions",
    "service discovery",
    "shared proxy traffic",
    "expected application protocol behavior"
  ],
  "verification": {
    "unit_tests": false,
    "replay_cases": 0,
    "independent_query_review": false,
    "adversarial_tests": false,
    "human_approved": false
  },
