  "roles": [
    "soc-analyst",
    "incident-responder",
    "threat-hunter"
  ],
  "match": {
    "tasks": [
      "alert-triage",
      "incident-response",
      "reanalysis",
      "threat-hunt"
    ],
    "protocols": [
      "any"
    ],
    "alert_families": [
      "suricata-alert"
    ],
    "data_sources": [
      "suricata",
      "elastic",
      "oql"
    ]
  },
  "objective": "Validate the exact Suricata SID and revision, determine which rule conditions were observed, and separate syntactic rule truth from malicious intent.",
  "capabilities": [
    "security-onion.events.query",
    "security-onion.oql.query",
    "suricata.events.read"
  ],
  "safety": {
    "read_only": true,
    "active_operation": false,
    "sensitivity": "moderate",
    "requires_approval": false
  },
  "budgets": {
    "max_queries": 4,
    "max_rows": 1000,
    "max_bytes": 1048576,
    "timeout_seconds": 90
  },
  "preconditions": [
    "bounded event time exists",
    "at least one endpoint or DNS identifier exists",
    "deployed field catalog is available"
  ],
  "required_evidence": [
    "exact SID revision and event identity",
    "bounded triggering flow",
    "rule metadata provenance"
  ],
  "query_templates": [
    {
      "id": "suricata-alert-context",
      "backend": "suricata",
      "language": "broker-parameters",
      "purpose": "Retrieve the bounded ECS alert identity and tuple; exact deployed-rule predicate validation remains separate runtime-owned evidence.",
      "parameters": [
        "alert_id",
        "start_time",
        "end_time"
      ],
      "expected_fields": [
        "@timestamp",
        "event.dataset",
        "rule.id",
        "rule.uuid",
        "rule.name",
        "source.ip",
        "destination.ip",
        "source.port",
        "destination.port",
        "network.transport"
      ]
    },
    {
      "id": "suricata-flow-context",
      "backend": "elastic",
      "language": "query-dsl",
      "purpose": "Correlate bounded flow and protocol observations around the exact Suricata event.",
      "parameters": [
        "source_alias",
        "destination_alias",
        "start_time",
        "end_time"
      ],
      "expected_fields": [
        "@timestamp",
        "source.ip",
        "destination.ip",
        "network.community_id",
        "network.bytes",
        "event.dataset",
        "rule.id"
      ]
    }
  ],
  "output_contract": {
    "schema": "onion-sentinel-skill-result-v1",
    "coverage_required": true,
    "truncation_required": true,
    "evidence_refs_required": true
  },
  "alternative_hypotheses": [
    "rule accurately matched benign activity",
    "policy violation without compromise",
    "scanner or test activity",
    "malicious activity matching rule intent"
  ],
  "stop_conditions": [
    "the discriminating question is answered with corroborated evidence",
    "the next pivot has low expected information value",
    "a budget or deadline is exhausted"
  ],
  "confidence_limiters": [
    "rule text or revision unavailable",
    "flow metadata incomplete",
    "payload encrypted or truncated",
    "environment authorization unknown"
  ],
  "known_false_positive_patterns": [
    "authorized testing",
    "known scanner behavior",
    "software update signatures",
    "protocol quirks matching broad content"
  ],
  "verification": {
    "unit_tests": false,
    "replay_cases": 0,
    "independent_query_review": false,
    "adversarial_tests": false,
    "human_approved": false
  },
