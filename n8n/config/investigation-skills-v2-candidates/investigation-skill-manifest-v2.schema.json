{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onion-sentinel.local/schemas/investigation-skill-manifest-v2.json",
  "title": "Onion Sentinel investigation skill manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "version", "artifact_digest", "lineage",
    "compatibility", "maintainer", "roles", "match", "objective",
    "capabilities", "safety", "budgets", "preconditions",
    "required_evidence", "query_templates", "output_contract",
    "alternative_hypotheses", "stop_conditions", "confidence_limiters",
    "known_false_positive_patterns", "verification", "references"
  ],
  "properties": {
    "schema": {"const": "onion-sentinel-investigation-skill-manifest-v2"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "artifact_digest": {"$ref": "#/$defs/digest"},
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["source_revision", "predecessor_digest"],
      "properties": {
        "source_revision": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
        "predecessor_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"const": ""}]}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["harness_contract", "policy_schema", "evidence_contract"],
      "properties": {
        "harness_contract": {"const": "onion-sentinel-harness-job-envelope-v1"},
        "policy_schema": {"type": "string", "minLength": 1, "maxLength": 100},
        "evidence_contract": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "maintainer": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "reviewed_at", "reviewer"],
      "properties": {
        "owner": {"type": "string", "minLength": 1, "maxLength": 100},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["soc-analyst", "incident-responder", "siem-engineer", "cyber-threat-intel", "threat-hunter"]}},
    "match": {
      "type": "object", "additionalProperties": false,
      "required": ["tasks", "protocols", "alert_families", "data_sources"],
      "properties": {
        "tasks": {"$ref": "#/$defs/stringSet"},
        "protocols": {"$ref": "#/$defs/stringSet"},
        "alert_families": {"$ref": "#/$defs/stringSet"},
        "data_sources": {"$ref": "#/$defs/stringSet"}
      }
    },
    "objective": {"type": "string", "minLength": 1, "maxLength": 1000},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,119}$"}},
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["read_only", "active_operation", "sensitivity", "requires_approval"],
      "properties": {
        "read_only": {"const": true},
        "active_operation": {"type": "boolean"},
        "sensitivity": {"enum": ["low", "moderate", "high"]},
        "requires_approval": {"type": "boolean"}
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["max_queries", "max_rows", "max_bytes", "timeout_seconds"],
      "properties": {
        "max_queries": {"type": "integer", "minimum": 1, "maximum": 12},
        "max_rows": {"type": "integer", "minimum": 1, "maximum": 5000},
        "max_bytes": {"type": "integer", "minimum": 1024, "maximum": 8388608},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    },
    "preconditions": {"$ref": "#/$defs/stringSet"},
    "required_evidence": {"$ref": "#/$defs/stringSet"},
    "query_templates": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "backend", "language", "purpose", "parameters", "expected_fields"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,79}$"},
          "backend": {"enum": ["elastic", "oql", "suricata", "zeek", "pcap-derived", "osquery-historical", "osquery-live", "threat-intel", "ac-hunter"]},
          "language": {"enum": ["query-dsl", "kql", "oql", "broker-parameters", "osquery-sql"]},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
          "parameters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}},
          "expected_fields": {"$ref": "#/$defs/stringSet"}
        }
      }
    },
    "output_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "coverage_required", "truncation_required", "evidence_refs_required", "fact_states"],
      "properties": {
        "schema": {"const": "onion-sentinel-skill-result-v1"},
        "coverage_required": {"const": true},
        "truncation_required": {"const": true},
        "evidence_refs_required": {"const": true},
        "fact_states": {"const": ["observed", "inferred", "unverified", "unavailable"]}
      }
    },
    "alternative_hypotheses": {"$ref": "#/$defs/stringSet"},
    "stop_conditions": {"$ref": "#/$defs/stringSet"},
    "confidence_limiters": {"$ref": "#/$defs/stringSet"},
    "known_false_positive_patterns": {"$ref": "#/$defs/stringSet"},
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_tests", "replay_cases", "independent_query_review", "adversarial_tests", "human_approved"],
      "properties": {
        "unit_tests": {"type": "boolean"},
        "replay_cases": {"type": "integer", "minimum": 0},
        "independent_query_review": {"type": "boolean"},
        "adversarial_tests": {"type": "boolean"},
        "human_approved": {"type": "boolean"}
      }
    },
    "references": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "url", "product_version", "retrieved_at"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "url": {"type": "string", "format": "uri"},
          "product_version": {"type": "string", "minLength": 1, "maxLength": 80},
          "retrieved_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stringSet": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
  }
}
