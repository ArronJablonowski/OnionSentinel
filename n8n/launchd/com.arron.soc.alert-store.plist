<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arron.soc.alert-store</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/n8n-local/bin/run-alert-store-host.zsh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/n8n-local</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/n8n-local/logs/alert-store-host.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/n8n-local/logs/alert-store-host.err.log</string>
</dict>
</plist>
