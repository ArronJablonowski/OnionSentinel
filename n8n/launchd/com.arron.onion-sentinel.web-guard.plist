<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arron.onion-sentinel.web-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/n8n-local/bin/ensure-onion-sentinel-web.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/n8n-local/logs/onion-sentinel-web-guard.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/n8n-local/logs/onion-sentinel-web-guard.err.log</string>
</dict>
</plist>
