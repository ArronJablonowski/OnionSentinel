<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arron.soc.ai-analysis</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/n8n-local/bin/auto-run-ai-analysis.py</string>
    <string>--provider-lane</string>
    <string>ollama</string>
    <string>--lock-file</string>
    <string>__HOME__/n8n-local/run/ai-analysis-ollama-worker.lock</string>
    <string>--wake-file</string>
    <string>__HOME__/n8n-local/run/ai-analysis-ollama.wake</string>
    <string>--levels</string>
    <string>critical,high,medium,low,informational</string>
    <string>--hours</string>
    <string>87600</string>
    <string>--max-per-run</string>
    <string>0</string>
    <string>--related-limit</string>
    <string>8</string>
    <string>--timeout</string>
    <string>600</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/n8n-local</string>

  <key>StartInterval</key>
  <integer>300</integer>

  <!-- Committed alert/evidence state touches this file for low-latency work.
       StartInterval remains the recovery path for a missed filesystem event. -->
  <key>WatchPaths</key>
  <array>
    <string>__HOME__/n8n-local/run/ai-analysis-ollama.wake</string>
  </array>

  <!-- WatchPaths can coalesce a change that occurs while the worker is still
       running. PathState makes a marker left at process exit authoritative, so
       evidence committed during inference always receives a follow-up run. -->
  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>__HOME__/n8n-local/run/ai-analysis-ollama.wake</key>
      <true/>
    </dict>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/n8n-local/logs/ai-analysis.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/n8n-local/logs/ai-analysis.err.log</string>
</dict>
</plist>
