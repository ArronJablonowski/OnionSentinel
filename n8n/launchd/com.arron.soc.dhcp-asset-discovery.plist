<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arron.soc.dhcp-asset-discovery</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/n8n-local/bin/collect-dhcp-asset-discovery.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/n8n-local</string>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/n8n-local/logs/dhcp-asset-discovery.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/n8n-local/logs/dhcp-asset-discovery.err.log</string>
</dict>
</plist>
