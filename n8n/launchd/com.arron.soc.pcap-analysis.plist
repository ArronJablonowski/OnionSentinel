<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arron.soc.pcap-analysis</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/n8n-local/bin/process-pcap-evidence.py</string>
    <string>--limit</string>
    <string>5</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/n8n-local</string>

  <key>StartInterval</key>
  <integer>300</integer>

  <!-- A fulfilled transfer wakes parsing immediately; the interval prevents a
       missed event or interrupted deployment from stranding durable work. -->
  <key>WatchPaths</key>
  <array>
    <string>__HOME__/n8n-local/run/pcap-analysis.wake</string>
  </array>

  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>__HOME__/n8n-local/run/pcap-analysis.wake</key>
      <true/>
    </dict>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/n8n-local/logs/pcap-analysis.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/n8n-local/logs/pcap-analysis.err.log</string>
</dict>
</plist>
