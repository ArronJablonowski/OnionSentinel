<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arron.n8n.monitor-stack</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/n8n-local/bin/monitor-n8n-stack.zsh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/n8n-local/logs/launchd-monitor-stack.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/n8n-local/logs/launchd-monitor-stack.err.log</string>
</dict>
</plist>
