<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arron.soc.dashboard-refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/n8n-local/bin/refresh-soc-dashboard.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/n8n-local</string>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>WatchPaths</key>
  <array>
    <string>__HOME__/n8n-local/run/dashboard-refresh.wake</string>
  </array>

  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>__HOME__/n8n-local/run/dashboard-refresh.wake</key>
      <true/>
    </dict>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/n8n-local/logs/dashboard-refresh.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/n8n-local/logs/dashboard-refresh.err.log</string>
</dict>
</plist>
